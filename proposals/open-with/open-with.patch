+  @MainActor
+  func testRejectsMissingFilesDirectoriesAndSymbolicLinks() throws {
+    let target = try makeSource(trackName: "Symlink target")
+    let original = try snapshot(of: target)
+    let directory = try XCTUnwrap(fixtureDirectory)
+    let symlink = directory.appendingPathComponent("linked.gpx")
+    try FileManager.default.createSymbolicLink(at: symlink, withDestinationURL: target)
+    let before = try stagingDirectories()
+
+    for source in [directory.appendingPathComponent("missing.gpx"), directory, symlink] {
+      XCTAssertThrowsError(try DeepLinkParser.addBookmarksFile(source))
+      XCTAssertEqual(try stagingDirectories(), before)
+    }
+    assertUnchanged(target, from: original)
+    XCTAssertEqual(try FileManager.default.destinationOfSymbolicLink(atPath: symlink.path), target.path)
+    XCTAssertEqual(fileSuccesses, 0)
