++ (BOOL)addBookmarksFile:(NSURL *)url error:(NSError **)error {
+  NSAssert(NSThread.isMainThread, @"Bookmark imports must run on the main thread");
+  if (!url.isFileURL) {
+    if (error)
+      *error = [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileReadUnsupportedSchemeError userInfo:nil];
+    return NO;
+  }
+
+  NSFileManager *files = NSFileManager.defaultManager;
+  BOOL scoped = [url startAccessingSecurityScopedResource];
+  // The coordinator can relocate the source. This preflight must not require
+  // the original path to remain readable once coordinated access begins.
+  NSDictionary *originalAttributes = [files attributesOfItemAtPath:url.path error:nullptr];
+  BOOL sourceIsSymlink = [originalAttributes[NSFileType] isEqual:NSFileTypeSymbolicLink];
+  __block NSURL *directory = nil;
+  __block NSURL *stagedURL = nil;
+  __block NSError *copyError = nil;
+  NSError *coordinationError = nil;
+  NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+  [coordinator coordinateReadingItemAtURL:url options:0 error:&coordinationError byAccessor:^(NSURL *fileURL) {
+    NSDictionary *attributes = [files attributesOfItemAtPath:fileURL.path error:&copyError];
+    if (!attributes)
+      return;
+    if (sourceIsSymlink || ![attributes[NSFileType] isEqual:NSFileTypeRegular] ||
+        !attributes[NSFileModificationDate]) {
+      copyError = [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileReadUnknownError
+                                 userInfo:@{NSLocalizedDescriptionKey: @"Only regular files can be imported."}];
+      return;
+    }
+
+    directory = [[[NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES]
+                  URLByAppendingPathComponent:@"CoMapsImports" isDirectory:YES]
+                 URLByAppendingPathComponent:NSUUID.UUID.UUIDString isDirectory:YES];
+    NSURL *destination = [directory URLByAppendingPathComponent:url.lastPathComponent];
+    if (![files createDirectoryAtURL:directory withIntermediateDirectories:YES attributes:nil error:&copyError] ||
+        ![files copyItemAtURL:fileURL toURL:destination error:&copyError])
+      return;
+    NSDictionary *copiedAttributes = [files attributesOfItemAtPath:destination.path error:&copyError];
+    if (!copiedAttributes)
+      return;
+    if (![copiedAttributes[NSFileType] isEqual:NSFileTypeRegular]) {
+      copyError = [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileReadUnknownError
+                                 userInfo:@{NSLocalizedDescriptionKey: @"The import copy must be a regular file."}];
+      return;
+    }
+    // Keep the timestamp copied with the file; setting it through NSDate can
+    // round away subsecond precision that copyItem preserved.
+    stagedURL = destination;
+  }];
+  if (scoped)
+    [url stopAccessingSecurityScopedResource];
+
+  if (!stagedURL || coordinationError) {
+    if (directory)
+      [files removeItemAtURL:directory error:nullptr];
+    if (error)
+      *error = coordinationError ?: copyError ?:
+          [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileReadUnknownError userInfo:nil];
+    return NO;
+  }
+
+  temporaryBookmarkDirectories()[stagedURL.path] = directory;
+  GetFramework().AddBookmarksFile(stagedURL.path.UTF8String, true /* isTemporaryFile */);
+  return YES;
+}
+
++ (void)removeTemporaryBookmarksFileAtPath:(NSString *)filePath {
+  NSMutableDictionary<NSString *, NSURL *> *directories = temporaryBookmarkDirectories();
+  NSURL *directory = directories[filePath];
+  if (!directory)
+    return;
+  [directories removeObjectForKey:filePath];
+  NSError *error = nil;
+  if (![NSFileManager.defaultManager removeItemAtURL:directory error:&error])
+    NSLog(@"Failed to remove temporary bookmark import: %@", error);
 }
 
 @end
