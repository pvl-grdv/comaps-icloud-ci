+  @MainActor
+  func testTwoQueuedFilesWithSameBasenameKeepSeparateContents() async throws {
+    let directory = try XCTUnwrap(fixtureDirectory)
+    let firstTitle = newCategoryTitle()
+    let secondTitle = newCategoryTitle()
+    let first = directory.appendingPathComponent("first/route.gpx")
+    let second = directory.appendingPathComponent("second/route.gpx")
+    for file in [first, second] {
+      try FileManager.default.createDirectory(at: file.deletingLastPathComponent(),
+                                              withIntermediateDirectories: true)
+    }
+    try gpx(trackName: "First route", category: firstTitle).write(to: first)
+    try gpx(trackName: "Second route", category: secondTitle).write(to: second)
+    let firstOriginal = try snapshot(of: first)
+    let secondOriginal = try snapshot(of: second)
+    let queueGate = await holdFileQueue()
+    defer { queueGate.unblock() }
+    let before = try stagingDirectories()
+    let finished = expectImport()
+    XCTAssertTrue(DeepLinkHandler.shared.applicationDidOpenUrl(first))
+    let firstStaged = try newStagedFile(since: before, basename: "route.gpx")
+    let afterFirst = try stagingDirectories()
+    XCTAssertTrue(DeepLinkHandler.shared.applicationDidOpenUrl(second))
+    let secondStaged = try newStagedFile(since: afterFirst, basename: "route.gpx")
+    XCTAssertNotEqual(firstStaged.deletingLastPathComponent(), secondStaged.deletingLastPathComponent())
+    assertUnchanged(firstStaged, from: firstOriginal)
+    assertUnchanged(secondStaged, from: secondOriginal)
+    queueGate.unblock()
+
+    await finishImport(finished, successes: 2)
+    XCTAssertEqual(try importedTrackNames(in: firstTitle), ["First route"])
+    XCTAssertEqual(try importedTrackNames(in: secondTitle), ["Second route"])
+    for staged in [firstStaged, secondStaged] {
+      XCTAssertFalse(FileManager.default.fileExists(atPath: staged.deletingLastPathComponent().path))
+    }
+    assertUnchanged(first, from: firstOriginal)
+    assertUnchanged(second, from: secondOriginal)
+  }
