+      let before = try stagingDirectories()
+      let finished = expectImport()
+      XCTAssertTrue(DeepLinkHandler.shared.applicationDidOpenUrl(source))
+      let staged = try newStagedFile(since: before, basename: source.lastPathComponent)
+      queueGate.unblock()
+
+      await finishImport(finished)
+      XCTAssertEqual(try importedTrackNames(in: title), [routeName])
+      XCTAssertFalse(FileManager.default.fileExists(atPath: staged.deletingLastPathComponent().path))
+      assertUnchanged(source, from: original)
+    }
+  }
