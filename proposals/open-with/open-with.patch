+
+  private var stagingRoot: URL {
+    FileManager.default.temporaryDirectory.appendingPathComponent("CoMapsImports", isDirectory: true)
+  }
+
+  private func stagingDirectories() throws -> Set<URL> {
+    guard FileManager.default.fileExists(atPath: stagingRoot.path) else { return [] }
+    return Set(try FileManager.default.contentsOfDirectory(at: stagingRoot,
+                                                          includingPropertiesForKeys: nil))
+  }
+
+  private func newStagedFile(since before: Set<URL>, basename: String) throws -> URL {
+    let added = try stagingDirectories().subtracting(before)
+    XCTAssertEqual(added.count, 1, "Exactly one owned import directory must be created")
+    let directory = try XCTUnwrap(added.first)
+    let file = directory.appendingPathComponent(basename)
+    XCTAssertTrue(FileManager.default.fileExists(atPath: file.path))
+    XCTAssertEqual(try FileManager.default.attributesOfItem(atPath: file.path)[.type] as? FileAttributeType,
+                   FileAttributeType.typeRegular)
+    return file
+  }
+
+  private typealias FileSnapshot = (hash: SHA256.Digest, date: Date)
+
+  private func snapshot(of source: URL) throws -> FileSnapshot {
+    (SHA256.hash(data: try Data(contentsOf: source)), try modificationDate(of: source))
+  }
+
+  private func assertUnchanged(_ source: URL, from original: FileSnapshot,
+                               file: StaticString = #filePath, line: UInt = #line) {
+    do {
+      let current = try snapshot(of: source)
+      XCTAssertEqual(current.hash, original.hash, "File contents must be preserved", file: file, line: line)
+      XCTAssertEqual(current.date, original.date, "File mtime must be preserved", file: file, line: line)
+    } catch {
+      XCTFail("Expected retained file: \(error)", file: file, line: line)
+    }
+  }
+
+  @MainActor
+  private func holdFileQueue() async -> OpenWithImportFileQueueGate {
+    let entered = expectation(description: "Real Platform::File queue is held")
+    let queueGate = OpenWithImportTestSupport.holdFileQueue { entered.fulfill() }
+    gate = queueGate
+    await fulfillment(of: [entered], timeout: 30)
+    XCTAssertFalse(queueGate.didTimeOut)
+    return queueGate
+  }
+
+  @MainActor
+  private func finishImport(_ finished: XCTestExpectation, successes: Int = 1, errors: Int = 0) async {
+    await fulfillment(of: [finished], timeout: 30)
+    XCTAssertFalse(gate?.didTimeOut ?? false)
+    XCTAssertEqual(fileSuccesses, successes)
+    XCTAssertEqual(fileErrors, errors)
+  }
+
+  private func newCategoryTitle() -> String {
+    let title = "Open With import fixture \(UUID().uuidString)"
+    categoryTitles.insert(title)
+    return title
+  }
+
+  @MainActor
+  private func expectImport() -> XCTestExpectation {
+    fileSuccesses = 0
+    fileErrors = 0
+    let finished = expectation(description: "Real bookmark import completed")
+    loading = finished
+    return finished
+  }
+
+  @MainActor
+  private func importedTrackNames(in title: String? = nil) throws -> [String] {
+    let category = try XCTUnwrap(manager.sortedUserCategories().first { $0.title == (title ?? categoryTitle) },
+                                "CONTROL: real importer must install the synthetic GPX category")
+    return category.tracks.map(\.trackName)
+  }
+
+  private func makeSource(trackName: String) throws -> URL {
+    let source = try XCTUnwrap(fixtureDirectory).appendingPathComponent("Original route.gpx")
+    try gpx(trackName: trackName).write(to: source)
+    try FileManager.default.setAttributes([.modificationDate: Date(timeIntervalSince1970: 1_700_000_000)],
+                                         ofItemAtPath: source.path)
+    return source
+  }
+
+  private func modificationDate(of source: URL) throws -> Date {
+    try XCTUnwrap(FileManager.default.attributesOfItem(atPath: source.path)[.modificationDate] as? Date)
+  }
+
+  private func gpx(trackName: String, category: String? = nil) -> Data {
+    Data("""
+    <?xml version="1.0" encoding="UTF-8"?>
+    <gpx version="1.1" creator="CoMaps XCTest" xmlns="http://www.topografix.com/GPX/1/1">
+      <metadata><name>\(category ?? categoryTitle)</name></metadata>
+      <trk><name>\(trackName)</name><trkseg>
+        <trkpt lat="41.70" lon="44.80"><ele>400</ele></trkpt>
+        <trkpt lat="41.71" lon="44.81"><ele>410</ele></trkpt>
+      </trkseg></trk>
+    </gpx>
+    """.utf8)
+  }
+
+  func onBookmarksLoadFinished() {
+    let finished = loading
+    loading = nil
+    finished?.fulfill()
+  }
+
+  func onBookmarksFileLoadSuccess() { fileSuccesses += 1 }
+  func onBookmarksFileLoadError() { fileErrors += 1 }
+}
