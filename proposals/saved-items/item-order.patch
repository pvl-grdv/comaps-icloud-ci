+      window.rootViewController = previousRoot
+      window.isHidden = wasHidden
+      if let previousKeyWindow { previousKeyWindow.makeKey() } else { window.resignKey() }
+      UIView.setAnimationsEnabled(animationsWereEnabled)
+    }
+    controller.loadViewIfNeeded()
+    await fulfillment(of: [appeared], timeout: 30)
+    window.layoutIfNeeded()
+    func descendants(_ view: UIView) -> [UIView] {
+      view.subviews + view.subviews.flatMap { descendants($0) }
+    }
+    let table = try XCTUnwrap(descendants(controller.view).compactMap { $0 as? UITableView }.first)
+    XCTAssertTrue(controller.view.window === window)
+    XCTAssertFalse(table.visibleCells.isEmpty)
+    try await body(controller, table)
+  }
+
+  @MainActor
+  private func save(bookmarks: [MWMMarkID], tracks: [MWMTrackID], in group: MWMMarkGroupID) -> Bool {
+    manager.setManualItemOrder(group, bookmarkIds: bookmarks.map { NSNumber(value: $0) },
+                               trackIds: tracks.map { NSNumber(value: $0) })
+  }
+
+  @MainActor
+  private func sortedSections(_ group: MWMMarkGroupID) async -> [BookmarksSection] {
+    let finished = expectation(description: "Read manual order")
+    var sections: [BookmarksSection] = []
+    manager.sortBookmarks(group, sortingType: .manual, location: nil) { result in
+      sections = result ?? []
+      finished.fulfill()
+    }
+    await fulfillment(of: [finished], timeout: 30)
+    return sections
+  }
+
+  func onBookmarksLoadFinished() {
+    let finished = pending
+    pending = nil
+    finished?.fulfill()
+  }
+
+  func onBookmarksFileLoadError() {
+    XCTFail("Synthetic manual-order fixture could not be imported")
+    let finished = pending
+    pending = nil
+    finished?.fulfill()
+  }
+}
