+UNIT_CLASS_TEST(Runner, ManualItemOrder_AppendsNewMovedItemsAndHandlesDeletion)
+{
+  BookmarkManager manager(BM_CALLBACKS);
+  manager.EnableTestMode(true);
+  auto const destination = CreateManualItemsCategory(manager, "manual append destination");
+  auto const source = CreateManualItemsCategory(manager, "manual append source", 1, 1);
+  auto const filePath = manager.GetCategoryFileName(destination.m_groupId);
+  auto const sourcePath = manager.GetCategoryFileName(source.m_groupId);
+  SCOPE_GUARD(fileDeleter, [&]() { (void)base::DeleteFileX(filePath); (void)base::DeleteFileX(sourcePath); });
+  TEST(manager.SetManualItemOrder(destination.m_groupId, destination.m_bookmarks, destination.m_tracks), ());
+  TEST(manager.SetManualItemOrder(source.m_groupId, source.m_bookmarks, source.m_tracks), ());
+  {
+    auto session = manager.GetEditSession();
+    session.GetBookmarkForEdit(source.m_bookmarks.front())->SetName("IncomingBookmark", kml::kDefaultLangCode);
+    session.GetTrackForEdit(source.m_tracks.front())->SetName("IncomingTrack");
+    session.MoveBookmark(source.m_bookmarks.front(), source.m_groupId, destination.m_groupId);
+    session.MoveTrack(source.m_tracks.front(), source.m_groupId, destination.m_groupId);
+  }
+  auto expected = ManualItemNames{{"Bookmark0", "Bookmark1", "IncomingBookmark"},
+                                  {"Track0", "Track1", "IncomingTrack"}};
+  TEST_EQUAL(GetManualItemNames(manager, destination.m_groupId), expected, ());
+  {
+    auto session = manager.GetEditSession();
+    kml::BookmarkData data;
+    kml::SetDefaultStr(data.m_name, "NewBookmark");
+    auto const id = session.CreateBookmark(std::move(data))->GetId();
+    session.AttachBookmark(id, destination.m_groupId);
+  }
+  expected.first.push_back("NewBookmark");
+  TEST_EQUAL(GetManualItemNames(manager, destination.m_groupId), expected, ());
+  {
+    auto session = manager.GetEditSession();
+    session.DeleteBookmark(destination.m_bookmarks.front());
+    session.DeleteTrack(destination.m_tracks.front());
+  }
+  expected.first.erase(expected.first.begin());
+  expected.second.erase(expected.second.begin());
+  TEST_EQUAL(GetManualItemNames(manager, destination.m_groupId), expected, ());
+  BookmarkManager reloadedManager(BM_CALLBACKS);
+  reloadedManager.EnableTestMode(true);
+  auto const reloaded = LoadManualItemsFile(reloadedManager, filePath);
+  TEST_EQUAL(GetManualItemNames(reloadedManager, reloaded), expected, ());
+}
