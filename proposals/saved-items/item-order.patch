+void BookmarkManager::AppendToManualItemOrder(kml::MarkGroupId groupId,
+                                                 std::optional<kml::MarkId> bookmarkId,
+                                                 std::optional<kml::TrackId> trackId)
+{
+  if (m_categories.find(groupId) == m_categories.end())
+    return;
+  SortingType mode;
+  if (!GetLastSortingType(groupId, mode) || mode != SortingType::Manual)
+    return;
+  std::set<uint64_t> ranks;
+  uint64_t maxRank = 0;
+  bool normalize = false;
+  auto inspect = [&](kml::Properties const & properties)
+  {
+    auto const rank = ParseManualItemOrder(properties);
+    if (!rank || !ranks.insert(*rank).second || *rank == std::numeric_limits<uint64_t>::max())
+    {
+      normalize = true;
+      return;
+    }
+    maxRank = std::max(maxRank, *rank);
+  };
+  if (bookmarkId)
+  {
+    for (auto const id : GetUserMarkIds(groupId))
+      if (id != *bookmarkId)
+        inspect(GetBookmark(id)->GetData().m_properties);
+  }
+  if (trackId)
+  {
+    for (auto const id : GetTrackIds(groupId))
+      if (id != *trackId)
+        inspect(GetTrack(id)->GetData().m_properties);
+  }
+  if (!normalize)
+  {
+    auto const rank = std::to_string(ranks.empty() ? 0 : maxRank + 1);
+    if (bookmarkId)
+    {
+      auto data = GetBookmark(*bookmarkId)->GetData();
+      data.m_properties[kItemOrderProperty] = rank;
+      GetBookmarkForEdit(*bookmarkId)->SetData(data);
+    }
+    if (trackId)
+      GetTrackForEdit(*trackId)->SetCustomProperty(kItemOrderProperty, rank);
+    return;
+  }
+  std::vector<SortBookmarkData> bookmarkData;
+  for (auto const id : GetUserMarkIds(groupId))
+  {
+    auto const * bookmark = GetBookmark(id);
+    bookmarkData.emplace_back(bookmark->GetData(), bookmark->GetAddress());
+  }
+  std::vector<SortTrackData> trackData;
+  for (auto const id : GetTrackIds(groupId))
+    trackData.emplace_back(GetTrack(id)->GetData());
+  SortedBlocksCollection blocks;
+  SortByManual(bookmarkData, trackData, blocks);
+  std::vector<kml::MarkId> bookmarks;
+  std::vector<kml::TrackId> tracks;
+  for (auto const & block : blocks)
+  {
+    bookmarks.insert(bookmarks.end(), block.m_markIds.begin(), block.m_markIds.end());
+    tracks.insert(tracks.end(), block.m_trackIds.begin(), block.m_trackIds.end());
+  }
+  if (bookmarkId)
+  {
+    std::erase(bookmarks, *bookmarkId);
+    bookmarks.push_back(*bookmarkId);
+  }
+  if (trackId)
+  {
+    std::erase(tracks, *trackId);
+    tracks.push_back(*trackId);
+  }
+  SetManualItemOrder(groupId, bookmarks, tracks);
+}
+
+std::optional<uint64_t> BookmarkManager::ParseManualItemOrder(kml::Properties const & properties)
+{
+  auto const it = properties.find(kItemOrderProperty);
+  if (it == properties.end() || it->second.empty())
+    return {};
+  uint64_t rank = 0;
+  auto const * begin = it->second.data();
+  auto const * end = begin + it->second.size();
+  auto const parsed = std::from_chars(begin, end, rank);
+  if (parsed.ec != std::errc{} || parsed.ptr != end)
+    return {};
+  return rank;
+}
+
+void BookmarkManager::SortByManual(std::vector<SortBookmarkData> const & bookmarksForSort,
+                                   std::vector<SortTrackData> const & tracksForSort,
+                                   SortedBlocksCollection & sortedBlocks)
+{
+  auto compare = [](auto const & left, auto const & right)
+  {
+    if (left.m_manualOrder.has_value() != right.m_manualOrder.has_value())
+      return left.m_manualOrder.has_value();
+    if (left.m_manualOrder && right.m_manualOrder)
+      return *left.m_manualOrder < *right.m_manualOrder;
+    return false;
+  };
+  auto sortedTracks = tracksForSort;
+  std::stable_sort(sortedTracks.begin(), sortedTracks.end(), compare);
+  AddTracksSortedBlock(sortedTracks, sortedBlocks);
+  auto sortedBookmarks = bookmarksForSort;
+  std::stable_sort(sortedBookmarks.begin(), sortedBookmarks.end(), compare);
+  if (!sortedBookmarks.empty())
+  {
+    SortedBlock block;
+    block.m_blockName = GetBookmarksSortedBlockName();
+    for (auto const & bookmark : sortedBookmarks)
+      block.m_markIds.push_back(bookmark.m_id);
+    sortedBlocks.push_back(std::move(block));
+  }
+}
