+  auto editSession = GetEditSession();
+  for (size_t i = 0; i < bookmarkIds.size(); ++i)
+  {
+    auto data = GetBookmark(bookmarkIds[i])->GetData();
+    auto const rank = std::to_string(i);
+    auto const property = data.m_properties.find(kItemOrderProperty);
+    if (property != data.m_properties.end() && property->second == rank)
+      continue;
+    data.m_properties[kItemOrderProperty] = rank;
+    editSession.GetBookmarkForEdit(bookmarkIds[i])->SetData(data);
+  }
+  for (size_t i = 0; i < trackIds.size(); ++i)
