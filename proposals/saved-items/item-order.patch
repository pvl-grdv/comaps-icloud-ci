+  @MainActor
+  private func assertItemEditButton(_ controller: BookmarksListViewController, editing: Bool) throws {
+    let button = try XCTUnwrap(controller.navigationItem.rightBarButtonItem)
+    XCTAssertTrue(button === controller.editButtonItem)
+    let bar = try XCTUnwrap(controller.navigationController?.navigationBar)
+    let window = try XCTUnwrap(controller.view.window)
+    window.layoutIfNeeded()
+    bar.layoutIfNeeded()
+    XCTAssertTrue(bar.window === window)
+    // UIKit may render the system Done item as a glyph instead of a text label.
+    // Inspect the actual visible control's public title/configuration/accessibility semantics.
+    var controls: [String] = []
+    func visibleTexts(in view: UIView) -> Set<String> {
+      guard !view.isHidden, view.alpha > 0, view.window === window, !view.bounds.isEmpty,
+            view.convert(view.bounds, to: window).intersects(window.bounds) else { return [] }
+      var texts = Set<String>()
+      if let label = view as? UILabel, let text = label.text, !text.isEmpty {
+        texts.insert(text)
+      }
+      if let control = view as? UIButton {
+        for text in [control.currentTitle, control.configuration?.title] {
+          if let text, !text.isEmpty { texts.insert(text) }
+        }
+        controls.append("UIButton frame=\(control.frame) title=\(control.currentTitle ?? "nil") configuration=\(control.configuration?.title ?? "nil") AX=\(control.accessibilityLabel ?? "nil")")
+      }
+      if view is UIButton || view.accessibilityTraits.contains(.button),
+         let label = view.accessibilityLabel, !label.isEmpty {
+        texts.insert(label)
+      }
+      for child in view.subviews { texts.formUnion(visibleTexts(in: child)) }
+      return texts
+    }
+    let texts = visibleTexts(in: bar)
+    let expectedTitle = L(editing ? "done" : "edit")
+    let previousTitle = L(editing ? "edit" : "done")
+    XCTAssertFalse(expectedTitle.isEmpty)
+    XCTAssertTrue(texts.contains(expectedTitle), "Visible navigation controls: \(texts); \(controls)")
+    XCTAssertFalse(texts.contains(previousTitle), "Visible navigation controls: \(texts); \(controls)")
+    XCTAssertEqual(controller.isEditing, editing)
+  }
