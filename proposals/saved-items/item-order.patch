+  params.m_sortingType = BookmarkManager::SortingType::Manual;
+  params.m_onResults = [&](BookmarkManager::SortedBlocksCollection && blocks, BookmarkManager::SortParams::Status status)
+  {
+    TEST(status == BookmarkManager::SortParams::Status::Completed, ());
+    for (auto const & block : blocks)
