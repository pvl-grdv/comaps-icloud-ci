+bool BookmarkManager::SetManualItemOrder(kml::MarkGroupId groupId,
+                                           std::vector<kml::MarkId> const & bookmarkIds,
+                                           std::vector<kml::TrackId> const & trackIds)
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  auto const category = m_categories.find(groupId);
+  if (category == m_categories.end())
+    return false;
+  auto const & currentBookmarks = category->second->GetUserMarks();
+  auto const & currentTracks = category->second->GetUserLines();
+  if (bookmarkIds.size() != currentBookmarks.size() || trackIds.size() != currentTracks.size() ||
+      kml::MarkIdSet(bookmarkIds.begin(), bookmarkIds.end()) != currentBookmarks ||
+      kml::TrackIdSet(trackIds.begin(), trackIds.end()) != currentTracks)
+    return false;
