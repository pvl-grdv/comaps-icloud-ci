+ManualItemsCategory CreateManualItemsCategory(BookmarkManager & manager, std::string const & name,
+                                               size_t bookmarkCount = 2, size_t trackCount = 2)
+{
+  df::VisualParams::Init(1.0, 1024);
+  TEST(Platform::MkDirChecked(GetBookmarksDirectory()), ());
+  ManualItemsCategory result{manager.CreateBookmarkCategory(name), {}, {}};
+  auto editSession = manager.GetEditSession();
+  for (size_t i = 0; i < bookmarkCount; ++i)
+  {
+    kml::BookmarkData data;
+    kml::SetDefaultStr(data.m_name, "Bookmark" + std::to_string(i));
+    data.m_point = m2::PointD(0, 0);
+    data.m_properties["unrelated"] = "retained bookmark value";
+    auto const id = editSession.CreateBookmark(std::move(data))->GetId();
+    editSession.AttachBookmark(id, result.m_groupId);
+    result.m_bookmarks.push_back(id);
+  }
+  for (size_t i = 0; i < trackCount; ++i)
+  {
+    kml::TrackData data;
+    kml::SetDefaultStr(data.m_name, "Track" + std::to_string(i));
+    data.m_layers.emplace_back();
+    data.m_geometry.AddLine({{{0.0, 0.0}, 1}, {{1.0, 0.0}, 2}});
+    data.m_geometry.AddTimestamps({});
+    data.m_properties["unrelated"] = "retained track value";
+    auto const id = editSession.CreateTrack(std::move(data))->GetId();
+    editSession.AttachTrack(id, result.m_groupId);
+    result.m_tracks.push_back(id);
+  }
+  return result;
