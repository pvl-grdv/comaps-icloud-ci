diff --git a/iphone/Maps/Bookmarks/BookmarksList/BookmarkItemOrder.swift b/iphone/Maps/Bookmarks/BookmarksList/BookmarkItemOrder.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Bookmarks/BookmarksList/BookmarkItemOrder.swift
@@ -0,0 +1,30 @@
+import Foundation
+
+struct BookmarkItemOrder: Equatable {
+  enum Section {
+    case bookmarks
+    case tracks
+  }
+
+  private(set) var bookmarkIds: [MWMMarkID]
+  private(set) var trackIds: [MWMTrackID]
+
+  init?(bookmarkIds: [MWMMarkID], trackIds: [MWMTrackID]) {
+    guard Set(bookmarkIds).count == bookmarkIds.count, Set(trackIds).count == trackIds.count else { return nil }
+    self.bookmarkIds = bookmarkIds
+    self.trackIds = trackIds
+  }
+
+  mutating func move(in section: Section, from source: Int, to target: Int) -> Bool {
+    switch section {
+    case .bookmarks: return Self.move(&bookmarkIds, from: source, to: target)
+    case .tracks: return Self.move(&trackIds, from: source, to: target)
+    }
+  }
+
+  private static func move<T>(_ items: inout [T], from source: Int, to target: Int) -> Bool {
+    guard items.indices.contains(source), items.indices.contains(target) else { return false }
+    if source != target { items.insert(items.remove(at: source), at: target) }
+    return true
+  }
+}
