+      for (auto const id : block.m_markIds)
+        result.first.push_back(kml::GetDefaultStr(manager.GetBookmark(id)->GetName()));
+      for (auto const id : block.m_trackIds)
+        result.second.push_back(manager.GetTrack(id)->GetName());
