new file mode 100644
index 0000000000000000000000000000000000000000..b6c11448606b2a2c55c98250306cda4164c0e51b
--- /dev/null
+++ b/iphone/Maps/Bookmarks/Categories/BMCViewModel/BMCSavedItemsSearchService.swift
@@ -0,0 +1,73 @@
+import Foundation
+
+final class BMCSavedItemsSearchService: BMCSearchService {
+  private let manager = BookmarksManager.shared()
+  private let groupId: MWMMarkGroupID?
+
+  init(groupId: MWMMarkGroupID? = nil) {
+    self.groupId = groupId
+  }
+
+  func prepare() {}
+
+  func release() {
+    manager.cancelSavedItemsSearch()
+  }
+
+  func search(_ text: String, completion: @escaping ([BMCSearchResult]) -> Void) {
+    let onResults: ([SavedItemSearchResult]) -> Void = { [weak self] items in
+      guard let self else { return }
+      completion(items.compactMap { item in
+        guard self.manager.hasCategory(item.categoryId) else { return nil }
+        let category = self.manager.category(withId: item.categoryId)
+        switch item.kind {
+        case .bookmark:
+          guard self.manager.hasBookmark(item.itemId) else { return nil }
+          let bookmark = self.manager.bookmark(withId: item.itemId)
+          return BMCSearchResult(item: .bookmark(item.itemId), categoryId: category.categoryId,
+                                 categoryName: category.title, name: bookmark.bookmarkName,
+                                 subtitle: bookmark.bookmarkType)
+        case .track:
+          guard self.manager.hasTrack(item.itemId) else { return nil }
+          let track = self.manager.track(withId: item.itemId)
+          let distance = DistanceFormatter.distanceString(fromMeters: Double(track.trackLengthMeters))
+          return BMCSearchResult(item: .track(item.itemId), categoryId: category.categoryId,
+                                 categoryName: category.title, name: track.trackName,
+                                 subtitle: "\(L("length")) \(distance)")
+        @unknown default:
+          return nil
+        }
+      })
+    }
+    if let groupId {
+      manager.searchSavedItems(inGroup: groupId, text: text, completion: onResults)
+    } else {
+      manager.searchAllSavedItems(text, completion: onResults)
+    }
+  }
+
+  func resolveSelection(_ result: BMCSearchResult) -> BMCSearchResult? {
+    let category: BookmarkGroup
+    switch result.item {
+    case .bookmark(let id):
+      guard manager.hasBookmark(id) else { return nil }
+      if let groupId {
+        guard manager.hasSavedItem(.bookmark, itemId: id, inGroup: groupId) else { return nil }
+        category = manager.category(withId: groupId)
+      } else {
+        category = manager.category(forBookmarkId: id)
+      }
+    case .track(let id):
+      guard manager.hasTrack(id) else { return nil }
+      if let groupId {
+        guard manager.hasSavedItem(.track, itemId: id, inGroup: groupId) else { return nil }
+        category = manager.category(withId: groupId)
+      } else {
+        category = manager.category(forTrackId: id)
+      }
+    }
+    guard manager.hasCategory(category.categoryId) else { return nil }
+    return BMCSearchResult(item: result.item, categoryId: category.categoryId,
+                           categoryName: category.title, name: result.name, subtitle: result.subtitle)
+  }
+}
diff --git a/iphone/Maps/Bookmarks/Categories/BMCViewModel/BMCSearchViewModel.swift b/iphone/Maps/Bookmarks/Categories/BMCViewModel/BMCSearchViewModel.swift
new file mode 100644
index 0000000000000000000000000000000000000000..038261d3e7e2d138ec6fef14ea7bfc7863a5c0a3
--- /dev/null
+++ b/iphone/Maps/Bookmarks/Categories/BMCViewModel/BMCSearchViewModel.swift
@@ -0,0 +1,106 @@
+import Foundation
+
+enum BMCSearchItem: Equatable {
+  case bookmark(MWMMarkID)
+  case track(MWMTrackID)
+}
+
+struct BMCSearchResult: Equatable {
+  let item: BMCSearchItem
+  let categoryId: MWMMarkGroupID
+  let categoryName: String
+  let name: String
+  let subtitle: String?
+}
+
+struct BMCSearchSection: Equatable {
+  let categoryId: MWMMarkGroupID
+  let title: String
+  var results: [BMCSearchResult]
+}
+
+protocol BMCSearchService: AnyObject {
+  func prepare()
+  func release()
+  func search(_ text: String, completion: @escaping ([BMCSearchResult]) -> Void)
+  func resolveSelection(_ result: BMCSearchResult) -> BMCSearchResult?
+}
+
+final class BMCSearchViewModel {
+  private let service: BMCSearchService
+  private var generation = 0
+  private(set) var isActive = false
+  private(set) var query = ""
+  private(set) var isSearching = false
+  private(set) var sections: [BMCSearchSection] = []
+  var onChange: (() -> Void)?
+
+  init(service: BMCSearchService) {
+    self.service = service
+  }
+
+  func start() {
+    guard !isActive else { return }
+    isActive = true
+    service.prepare()
+    search(query)
+  }
+
+  func stop() {
+    guard isActive else { return }
+    generation += 1
+    isActive = false
+    isSearching = false
+    query = ""
+    sections = []
+    service.release()
+    onChange?()
+  }
+
+  func search(_ text: String) {
+    generation += 1
+    let requestedGeneration = generation
+    query = text.trimmingCharacters(in: .whitespacesAndNewlines)
+    sections = []
+    isSearching = isActive && !query.isEmpty
+    onChange?()
+    guard isSearching else { return }
+    service.search(query) { [weak self] results in
+      guard let self, isActive, generation == requestedGeneration else { return }
+      isSearching = false
+      sections = Self.group(results)
+      onChange?()
+    }
+  }
+
+  func refresh() {
+    guard isActive else { return }
+    service.prepare()
+    search(query)
+  }
+
+  func selectResult(section: Int, row: Int) -> BMCSearchResult? {
+    guard sections.indices.contains(section), sections[section].results.indices.contains(row) else { return nil }
+    guard let result = service.resolveSelection(sections[section].results[row]) else {
+      refresh()
+      return nil
+    }
+    return result
+  }
+
+  private static func group(_ results: [BMCSearchResult]) -> [BMCSearchSection] {
+    var sections: [BMCSearchSection] = []
+    var sectionIndexes: [MWMMarkGroupID: Int] = [:]
+    for result in results {
+      if let index = sectionIndexes[result.categoryId] {
+        sections[index].results.append(result)
+      } else {
+        sectionIndexes[result.categoryId] = sections.count
+        sections.append(BMCSearchSection(categoryId: result.categoryId,
+                                         title: result.categoryName,
+                                         results: [result]))
+      }
+    }
+    return sections
+  }
+}
