@@ -0,0 +1,57 @@
+#pragma once
+
+#include "search/bookmarks/data.hpp"
+#include "search/bookmarks/types.hpp"
+
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace search::bookmarks
+{
+enum class ItemKind
+{
+  Bookmark,
+  Track
+};
+
+struct ItemId
+{
+  ItemKind m_kind = ItemKind::Bookmark;
+  uint64_t m_id = 0;
+
+  bool operator==(ItemId const &) const = default;
+  bool operator<(ItemId const & other) const
+  {
+    return std::tie(m_kind, m_id) < std::tie(other.m_kind, other.m_id);
+  }
+};
+
+inline std::string DebugPrint(ItemId const & id)
+{
+  return std::string(id.m_kind == ItemKind::Bookmark ? "Bookmark:" : "Track:") + std::to_string(id.m_id);
+}
+
+struct ItemDocument
+{
+  ItemId m_item;
+  GroupId m_groupId = kInvalidGroupId;
+  Data m_data;
+};
+
+struct ItemResult
+{
+  ItemId m_item;
+  GroupId m_groupId = kInvalidGroupId;
+
+  bool operator==(ItemResult const &) const = default;
+};
+
+inline std::string DebugPrint(ItemResult const & result)
+{
+  return DebugPrint(result.m_item) + "@" + std::to_string(result.m_groupId);
+}
+
+using ItemResults = std::vector<ItemResult>;
+
+}
diff --git a/libs/search/bookmarks/saved_items_index.hpp b/libs/search/bookmarks/saved_items_index.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..070f4ad9af2a8c760bbdf52330c2221e1ff1b171
--- /dev/null
+++ b/libs/search/bookmarks/saved_items_index.hpp
@@ -0,0 +1,77 @@
+#pragma once
+
+#include "search/bookmarks/processor.hpp"
+#include "search/bookmarks/saved_items.hpp"
+#include "search/bookmarks/results.hpp"
+#include "search/emitter.hpp"
+
+#include <map>
+#include <set>
+#include <vector>
+
+namespace search::bookmarks
+{
+class SavedItemsIndex
+{
+public:
+  explicit SavedItemsIndex(base::Cancellable const & cancellable, bool indexDescriptions = false)
+    : m_cancellable(cancellable)
+    , m_processor(m_emitter, cancellable)
+    , m_indexDescriptions(indexDescriptions)
+  {}
+
+  bool Replace(std::vector<ItemDocument> const & documents)
+  {
+    std::map<ItemId, ItemDocument const *> ordered;
+    for (auto const & document : documents)
+    {
+      ::search::BailIfCancelled(m_cancellable);
+      if (document.m_groupId == kInvalidGroupId || !ordered.emplace(document.m_item, &document).second)
+        return false;
+    }
+
+    m_valid = false;
+    m_processor.Reset();
+    m_processor.EnableIndexingOfDescriptions(m_indexDescriptions);
+    m_items.clear();
+    m_items.reserve(ordered.size());
+    std::set<GroupId> groups;
+    for (auto const & [item, document] : ordered)
+    {
+      ::search::BailIfCancelled(m_cancellable);
+      auto const indexId = static_cast<Id>(m_items.size());
+      m_processor.Add(indexId, document->m_data);
+      m_processor.AttachToGroup(indexId, document->m_groupId);
+      m_items.push_back({item, document->m_groupId});
+      groups.insert(document->m_groupId);
+    }
+    for (auto const & group : groups)
+    {
+      ::search::BailIfCancelled(m_cancellable);
+      m_processor.EnableIndexingOfBookmarkGroup(group, true);
+    }
+    m_valid = true;
+    return true;
+  }
+
+  ItemResults Search(Processor::Params const & params)
+  {
+    if (!m_valid)
+      return {};
+    m_emitter.Init([](::search::Results const &) {});
+    m_processor.Search(params);
+    ItemResults results;
+    for (auto const & result : m_emitter.GetResults().GetBookmarksResults())
+      results.push_back(m_items.at(result.m_id));
+    return results;
+  }
+
+private:
+  base::Cancellable const & m_cancellable;
+  Emitter m_emitter;
+  Processor m_processor;
+  bool const m_indexDescriptions;
+  bool m_valid = true;
+  ItemResults m_items;
+};
+}
