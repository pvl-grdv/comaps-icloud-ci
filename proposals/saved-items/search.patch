@@ -0,0 +1,135 @@
+import UIKit
+
+final class BMCSearchResultsViewController: UITableViewController {
+  private let manager = BookmarksManager.shared()
+  private let model = BMCSearchViewModel(service: BMCSavedItemsSearchService())
+  var onSelect: ((BMCSearchResult) -> Void)?
+
+  init() {
+    super.init(style: .plain)
+    model.onChange = { [weak self] in self?.updateResults() }
+  }
+
+  required init?(coder: NSCoder) {
+    fatalError("init(coder:) has not been implemented")
+  }
+
+  deinit {
+    model.stop()
+  }
+
+  override func viewDidLoad() {
+    super.viewDidLoad()
+    view.setStyle(.pressBackground)
+    tableView.registerNibs([BookmarksListCell.self])
+    tableView.tableFooterView = UIView()
+    tableView.keyboardDismissMode = .onDrag
+    updateResults()
+  }
+
+  func start() {
+    manager.add(self)
+    model.start()
+  }
+
+  func stop() {
+    manager.remove(self)
+    model.stop()
+  }
+
+  private func updateResults() {
+    guard isViewLoaded else { return }
+    tableView.reloadData()
+    if model.isSearching {
+      let activity = UIActivityIndicatorView(style: .medium)
+      activity.startAnimating()
+      tableView.backgroundView = activity
+    } else if !model.query.isEmpty && model.sections.isEmpty {
+      let label = UILabel()
+      label.text = L("search_not_found")
+      label.textAlignment = .center
+      label.numberOfLines = 0
+      label.textColor = .secondaryLabel
+      tableView.backgroundView = label
+    } else {
+      tableView.backgroundView = nil
+    }
+  }
+
+  override func numberOfSections(in tableView: UITableView) -> Int {
+    model.sections.count
+  }
+
+  override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+    model.sections[section].results.count
+  }
+
+  override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+    model.sections[section].title
+  }
+
+  override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+    let cell = tableView.dequeueReusableCell(cell: BookmarksListCell.self, indexPath: indexPath)
+    let result = model.sections[indexPath.section].results[indexPath.row]
+    cell.accessoryType = .none
+    var image = UIImage()
+    switch result.item {
+    case .bookmark(let id):
+      if manager.hasBookmark(id) {
+        let bookmark = manager.bookmark(withId: id)
+        image = bookmark.bookmarkColor.image(bookmark.bookmarkIconName)
+      }
+    case .track(let id):
+      if manager.hasTrack(id) {
+        image = circleImageForColor(manager.track(withId: id).trackColor, frameSize: 22)
+      }
+    }
+    cell.config(BMCSearchCellViewModel(name: result.name, subtitle: result.subtitle ?? "", image: image,
+                                       colorDidTapAction: { [weak self, weak cell] in
+      guard let self, let cell, let indexPath = self.tableView.indexPath(for: cell) else { return }
+      selectResult(at: indexPath)
+    }))
+    return cell
+  }
+
+  override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+    tableView.deselectRow(at: indexPath, animated: true)
+    selectResult(at: indexPath)
+  }
+
+  private func selectResult(at indexPath: IndexPath) {
+    guard let result = model.selectResult(section: indexPath.section, row: indexPath.row) else { return }
+    onSelect?(result)
+  }
+}
+
+private struct BMCSearchCellViewModel: IBookmarksListItemViewModel {
+  let name: String
+  let subtitle: String
+  let image: UIImage
+  let colorDidTapAction: (() -> Void)?
+}
+
+extension BMCSearchResultsViewController: UISearchResultsUpdating {
+  func updateSearchResults(for searchController: UISearchController) {
+    model.search(searchController.searchBar.text ?? "")
+  }
+}
+
+extension BMCSearchResultsViewController: BookmarksObserver {
+  func onBookmarksLoadFinished() {
+    model.refresh()
+  }
+
+  func onBookmarksFileLoadSuccess() {
+    model.refresh()
+  }
+
+  func onBookmarksCategoryDeleted(_ groupId: MWMMarkGroupID) {
+    model.refresh()
+  }
+
+  func onBookmarkDeleted(_ bookmarkId: MWMMarkID) {
+    model.refresh()
+  }
