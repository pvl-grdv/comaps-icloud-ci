+namespace saved_items_processor_tests
+{
+using SavedItemsProcessorTest = generator::tests_support::TestWithClassificator;
+
+UNIT_CLASS_TEST(SavedItemsProcessorTest, CancelledBeforeProcessingCompletesTypedCallback)
+{
+  FrozenDataSource dataSource;
+  storage::CountryInfoGetterForTesting infoGetter;
+  std::vector<search::Suggest> suggestions;
+  search::Processor processor(dataSource, GetDefaultCategories(), suggestions, infoGetter);
+  search::SearchParams params;
+  params.m_mode = search::Mode::Bookmarks;
+  params.m_savedItems = std::make_shared<std::vector<search::bookmarks::ItemDocument> const>();
+  params.m_onStarted = [&] { processor.Cancel(); };
+  size_t typedCallbacks = 0;
+  size_t legacyCallbacks = 0;
+  params.m_onSavedItemsResults = [&](search::bookmarks::ItemResults results, bool cancelled)
+  {
+    ++typedCallbacks;
+    TEST(cancelled, ());
+    TEST(results.empty(), ());
+  };
+  params.m_onResults = [&](search::Results const & results)
+  {
+    ++legacyCallbacks;
+    TEST(results.IsEndMarker(), ());
+    TEST(results.IsEndedCancelled(), ());
+  };
+  processor.Search(std::move(params));
+  TEST_EQUAL(typedCallbacks, 1, ());
+  TEST_EQUAL(legacyCallbacks, 1, ());
+}
+
+UNIT_CLASS_TEST(SavedItemsProcessorTest, CancelledLegacyRequestStillCompletes)
+{
+  FrozenDataSource dataSource;
+  storage::CountryInfoGetterForTesting infoGetter;
+  std::vector<search::Suggest> suggestions;
+  search::Processor processor(dataSource, GetDefaultCategories(), suggestions, infoGetter);
+  search::SearchParams params;
+  params.m_mode = search::Mode::Bookmarks;
+  params.m_onStarted = [&] { processor.Cancel(); };
+  size_t callbacks = 0;
+  params.m_onResults = [&](search::Results const & results)
+  {
+    ++callbacks;
+    TEST(results.IsEndMarker(), ());
+    TEST(results.IsEndedCancelled(), ());
+  };
+  processor.Search(std::move(params));
+  TEST_EQUAL(callbacks, 1, ());
+}
