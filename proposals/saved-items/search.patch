+class SavedItemsIndexTest : public generator::tests_support::TestWithClassificator
+{
+public:
+  SavedItemsIndexTest() : m_index(m_cancellable, true) {}
+
+  bool Replace(std::vector<ItemDocument> const & documents) { return m_index.Replace(documents); }
+  void Cancel() { m_cancellable.Cancel(); }
+
+  ItemResults Search(std::string const & query, GroupId group = kInvalidGroupId,
+                     size_t limit = SearchParams::kDefaultNumResultsEverywhere)
+  {
+    std::vector<strings::UniString> tokens;
+    auto const isPrefix = TokenizeStringAndCheckIfLastTokenIsPrefix(query, tokens);
+    bookmarks::Processor::Params params;
+    params.Init(query, tokens, isPrefix);
+    params.m_groupId = group;
+    params.m_maxNumResults = limit;
+    return m_index.Search(params);
+  }
+
+  ItemDocument BookmarkDocument(uint64_t id, GroupId group, std::string const & name)
+  {
+    auto data = MakeBookmarkData(name, "", "", {});
+    return {{ItemKind::Bookmark, id}, group, Data(data)};
+  }
+
+  ItemDocument TrackDocument(uint64_t id, GroupId group, std::string const & name,
+                             std::string const & description = {})
+  {
+    kml::TrackData data;
+    kml::SetDefaultStr(data.m_name, name);
+    kml::SetDefaultStr(data.m_description, description);
+    return {{ItemKind::Track, id}, group, Data(data)};
+  }
+
+private:
+  base::Cancellable m_cancellable;
+  SavedItemsIndex m_index;
+};
+
+UNIT_CLASS_TEST(SavedItemsIndexTest, CollidingNumericIds)
+{
+  auto const id = std::numeric_limits<uint64_t>::max();
+  TEST(Replace({BookmarkDocument(id, 10, "River"), TrackDocument(id, 20, "River")}), ());
+  auto const results = Search("river");
+  TEST_EQUAL(results.size(), 2, ());
+  std::set<ItemId> ids;
+  for (auto const & result : results)
+    ids.insert(result.m_item);
+  TEST_EQUAL(ids, (std::set<ItemId>{{ItemKind::Bookmark, id}, {ItemKind::Track, id}}), ());
+  TEST_EQUAL(Search("river", 10), (ItemResults{{{ItemKind::Bookmark, id}, 10}}), ());
+  TEST_EQUAL(Search("river", 20), (ItemResults{{{ItemKind::Track, id}, 20}}), ());
+  TEST_EQUAL(Search("river", kInvalidGroupId, 1).size(), 1, ());
+}
+
+UNIT_CLASS_TEST(SavedItemsIndexTest, UnicodePrefixAndDescription)
+{
+  TEST(Replace({BookmarkDocument(1, 10, "Riverside"),
+                TrackDocument(2, 10, "Café Тропа", "Сосновый лес")}), ());
+  auto const expected = ItemResults{{{ItemKind::Track, 2}, 10}};
+  TEST_EQUAL(Search("cafe"), expected, ());
+  TEST_EQUAL(Search("тро"), expected, ());
+  TEST_EQUAL(Search("сосн"), expected, ());
+}
+
+UNIT_CLASS_TEST(SavedItemsIndexTest, OriginalAndCustomNamesSurviveUpdates)
+{
+  auto data = MakeBookmarkData("Double R Diner", "2R Diner", "", {});
+  auto const expected = ItemResults{{{ItemKind::Bookmark, 7}, 10}};
+  TEST(Replace({{{ItemKind::Bookmark, 7}, 10, Data(data)}}), ());
+  TEST_EQUAL(Search("double"), expected, ());
+  TEST_EQUAL(Search("2r"), expected, ());
+
+  kml::SetDefaultStr(data.m_customName, "Renamed Label");
+  TEST(Replace({{{ItemKind::Bookmark, 7}, 10, Data(data)}}), ());
+  TEST_EQUAL(Search("double"), expected, ());
+  TEST_EQUAL(Search("renamed"), expected, ());
+
+  kml::SetDefaultStr(data.m_name, "Glacier Cabin");
+  TEST(Replace({{{ItemKind::Bookmark, 7}, 10, Data(data)}}), ());
+  TEST(Search("double").empty(), ());
+  TEST_EQUAL(Search("glacier"), expected, ());
+  TEST_EQUAL(Search("renamed"), expected, ());
+}
+
+UNIT_CLASS_TEST(SavedItemsIndexTest, SnapshotRenameMoveDeleteReload)
+{
+  TEST(Replace({TrackDocument(7, 10, "Sequoia")}), ());
+  TEST_EQUAL(Search("sequoia", 10), (ItemResults{{{ItemKind::Track, 7}, 10}}), ());
+  TEST(Replace({TrackDocument(7, 11, "Glacier")}), ());
+  TEST(Search("sequoia").empty(), ());
+  TEST(Search("glacier", 10).empty(), ());
+  TEST_EQUAL(Search("glacier", 11), (ItemResults{{{ItemKind::Track, 7}, 11}}), ());
+  TEST(Replace({TrackDocument(77, 11, "Glacier")}), ());
+  TEST_EQUAL(Search("glacier"), (ItemResults{{{ItemKind::Track, 77}, 11}}), ());
+  TEST(Replace({}), ());
+  TEST(Search("glacier").empty(), ());
+}
+
+UNIT_CLASS_TEST(SavedItemsIndexTest, InvalidSnapshotRetainsPreviousIndex)
+{
+  TEST(Replace({BookmarkDocument(4, 10, "Lagoon")}), ());
+  TEST(!Replace({BookmarkDocument(4, 10, "Lagoon"), BookmarkDocument(4, 20, "Desert")}), ());
+  TEST_EQUAL(Search("lagoon"), (ItemResults{{{ItemKind::Bookmark, 4}, 10}}), ());
+  auto invalid = TrackDocument(9, kInvalidGroupId, "Glacier");
+  TEST(!Replace({invalid}), ());
+  TEST_EQUAL(Search("lagoon"), (ItemResults{{{ItemKind::Bookmark, 4}, 10}}), ());
+}
+
+UNIT_CLASS_TEST(SavedItemsIndexTest, CancelledSearch)
+{
+  TEST(Replace({TrackDocument(7, 10, "Sequoia")}), ());
+  Cancel();
+  bool cancelled = false;
+  try
+  {
+    Search("sequoia");
+  }
+  catch (::search::CancelException const &)
+  {
+    cancelled = true;
+  }
+  TEST(cancelled, ());
+}
+
 }  // namespace bookmarks_processor_tests
