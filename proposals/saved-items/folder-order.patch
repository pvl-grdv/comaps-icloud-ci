+      type = BookmarkManager::CategorySortType::ByLastModified;
+      break;
+    case MWMBookmarkCategorySortingTypeByName:
+      type = BookmarkManager::CategorySortType::ByName;
+      break;
+    case MWMBookmarkCategorySortingTypeManual:
+      for (auto const groupId : self.bm.GetUnsortedBmGroupsIdList()) {
+        if (self.bm.GetCategoryFileName(groupId).empty() && !self.bm.SaveBookmarkCategory(groupId))
+          return NO;
+      }
+      type = BookmarkManager::CategorySortType::Manual;
+      break;
+    default:
+      return NO;
+  }
+  self.bm.SetCategorySortType(type);
+  return YES;
+}
+
+- (BOOL)moveCategory:(MWMMarkGroupID)groupId toPosition:(NSInteger)position {
+  if (self.bm.GetCategorySortType() != BookmarkManager::CategorySortType::Manual)
+    return NO;
+  auto const & categories = self.bm.GetUnsortedBmGroupsIdList();
+  if (position < 0 || static_cast<size_t>(position) >= categories.size() ||
+      std::find(categories.begin(), categories.end(), groupId) == categories.end())
+    return NO;
+  self.bm.MoveCategoryToPosition(groupId, static_cast<size_t>(position));
+  auto const order = self.bm.GetSortedBmGroupIdList();
+  return static_cast<size_t>(position) < order.size() && order[position] == groupId;
+}
