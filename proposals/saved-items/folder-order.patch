@@ -0,0 +1,187 @@
+import UIKit
+import XCTest
+@testable import CoMaps__Debug_
+
+final class BookmarkFolderOrderTests: XCTestCase {
+  private var manager: BookmarksManager!
+  private var originalSortingType: BookmarkCategorySortingType!
+  private var categoryIds: [MWMMarkGroupID] = []
+
+  override func setUpWithError() throws {
+    try super.setUpWithError()
+    manager = BookmarksManager.shared()
+    manager.loadBookmarks()
+    let loaded = XCTNSPredicateExpectation(predicate: NSPredicate { [weak self] _, _ in
+      self?.manager?.areBookmarksLoaded() == true
+    }, object: nil)
+    guard XCTWaiter.wait(for: [loaded], timeout: 30) == .completed else {
+      throw NSError(domain: "BookmarkFolderOrderTests", code: 1,
+                    userInfo: [NSLocalizedDescriptionKey: "Bookmarks did not finish loading"])
+    }
+    originalSortingType = manager.categorySortingType()
+    let suffix = UUID().uuidString
+    categoryIds = [
+      manager.createCategory(withName: "Folder order A " + suffix),
+      manager.createCategory(withName: "Folder order B " + suffix)
+    ]
+  }
+
+  override func tearDown() {
+    saveFixturesBeforeDeletion()
+    categoryIds.filter { manager.hasCategory($0) }.forEach { manager.deleteCategory($0) }
+    if let originalSortingType {
+      _ = manager.setCategorySortingType(originalSortingType)
+    }
+    manager = nil
+    originalSortingType = nil
+    categoryIds = []
+    super.tearDown()
+  }
+
+  private func saveFixturesBeforeDeletion() {
+    guard categoryIds.contains(where: { manager.hasCategory($0) }) else { return }
+    // Baseline deletion needs a saved filename. Keep setup unsaved so the
+    // manual-order test still exercises the first-save path itself.
+    let sortingType = manager.categorySortingType()
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    XCTAssertTrue(manager.setCategorySortingType(sortingType))
+  }
+
+  private var sortedIds: [MWMMarkGroupID] {
+    manager.sortedUserCategories().map(\.categoryId)
+  }
+
+  func testManualOrderMovesNewEmptyCategories() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let originalIds = sortedIds
+    let movingId = categoryIds[1]
+    XCTAssertTrue(manager.moveCategory(movingId, toPosition: 0))
+    XCTAssertEqual(manager.categorySortingType(), .manual)
+    XCTAssertEqual(sortedIds.first, movingId)
+    XCTAssertEqual(Set(sortedIds), Set(originalIds))
+    XCTAssertEqual(sortedIds.filter { $0 != movingId }, originalIds.filter { $0 != movingId })
+    XCTAssertTrue(manager.moveCategory(movingId, toPosition: originalIds.count - 1))
+    XCTAssertEqual(sortedIds.last, movingId)
+  }
+
+  func testAutomaticModeRejectsMoves() {
+    XCTAssertTrue(manager.setCategorySortingType(.byName))
+    let originalIds = sortedIds
+    XCTAssertFalse(manager.moveCategory(categoryIds[1], toPosition: 0))
+    XCTAssertEqual(manager.categorySortingType(), .byName)
+    XCTAssertEqual(sortedIds, originalIds)
+  }
+
+  func testInvalidDestinationsLeaveOrderUntouched() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let originalIds = sortedIds
+    XCTAssertFalse(manager.moveCategory(categoryIds[0], toPosition: -1))
+    XCTAssertFalse(manager.moveCategory(categoryIds[0], toPosition: originalIds.count))
+    XCTAssertEqual(sortedIds, originalIds)
+  }
+
+  func testUnknownCategoryLeavesOrderUntouched() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let originalIds = sortedIds
+    XCTAssertFalse(manager.moveCategory(MWMMarkGroupID.max, toPosition: 0))
+    XCTAssertEqual(sortedIds, originalIds)
+  }
+
+  func testNewFolderIsAppendedToExistingManualOrder() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    XCTAssertTrue(manager.moveCategory(categoryIds[1], toPosition: 0))
+    let originalIds = sortedIds
+    let newId = manager.createCategory(withName: "Folder order new " + UUID().uuidString)
+    categoryIds.append(newId)
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    XCTAssertEqual(Array(sortedIds.prefix(originalIds.count)), originalIds)
+    XCTAssertEqual(sortedIds.last, newId)
+  }
+
+  func testAutomaticSortRestoresCategoryNameOrder() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    XCTAssertTrue(manager.moveCategory(categoryIds[1], toPosition: 0))
+    XCTAssertTrue(manager.setCategorySortingType(.byName))
+    let ids = sortedIds.filter { categoryIds.contains($0) }
+    XCTAssertEqual(ids, [categoryIds[0], categoryIds[1]])
+  }
+
+  @MainActor
+  func testMenuTargetRemainsSameCategoryAfterOrderChanges() throws {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let model = BMCDefaultViewModel()
+    let targetId = categoryIds[1]
+    let oldIndex = try XCTUnwrap(model.categoryIndex(forId: targetId))
+    let destination = oldIndex == 0 ? sortedIds.count - 1 : 0
+    XCTAssertTrue(manager.moveCategory(targetId, toPosition: destination))
+    model.reloadData()
+    let currentIndex = try XCTUnwrap(model.categoryIndex(forId: targetId))
+    XCTAssertNotEqual(currentIndex, oldIndex)
+    saveFixturesBeforeDeletion()
+    model.deleteCategory(at: currentIndex)
+    XCTAssertFalse(manager.hasCategory(targetId))
+    XCTAssertTrue(manager.hasCategory(categoryIds[0]))
+  }
+
+  @MainActor
+  func testRemovedMenuTargetNoLongerResolvesToAnotherCategory() {
+    let model = BMCDefaultViewModel()
+    let targetId = categoryIds[1]
+    XCTAssertNotNil(model.categoryIndex(forId: targetId))
+    saveFixturesBeforeDeletion()
+    manager.deleteCategory(targetId)
+    XCTAssertFalse(manager.hasCategory(targetId))
+    model.reloadData()
+    XCTAssertNil(model.categoryIndex(forId: targetId))
+    XCTAssertTrue(manager.hasCategory(categoryIds[0]))
+  }
+
+  @MainActor
+  func testHostedFolderReorderingUpdatesDisplayedAndStoredOrder() throws {
+    let scene = try XCTUnwrap(UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+      .first { $0.session.role == .windowApplication })
+    let window = try XCTUnwrap(scene.windows.first { $0.isKeyWindow && $0.rootViewController != nil }
+      ?? scene.windows.first { $0.rootViewController != nil })
+    let previousRoot = try XCTUnwrap(window.rootViewController)
+    let wasHidden = window.isHidden
+    let controller = BMCViewController(coordinator: nil)
+    window.rootViewController = UINavigationController(rootViewController: controller)
+    window.makeKeyAndVisible()
+    defer {
+      controller.setEditing(false, animated: false)
+      window.rootViewController = previousRoot
+      window.isHidden = wasHidden
+    }
+    controller.loadViewIfNeeded()
+    window.layoutIfNeeded()
+    let table = try XCTUnwrap(findTable(in: controller.view))
+    XCTAssertTrue(controller.view.window === window)
+    XCTAssertEqual(table.numberOfRows(inSection: 0), sortedIds.count)
+    controller.setEditing(true, animated: false)
+    XCTAssertTrue(controller.isEditing)
+    XCTAssertTrue(table.isEditing)
+    XCTAssertEqual(manager.categorySortingType(), .manual)
+    let movingId = categoryIds[1]
+    let source = IndexPath(row: try XCTUnwrap(sortedIds.firstIndex(of: movingId)), section: 0)
+    let target = IndexPath(row: source.row == 0 ? sortedIds.count - 1 : 0, section: 0)
+    XCTAssertTrue(controller.tableView(table, canMoveRowAt: source))
+    XCTAssertFalse(controller.tableView(table, canMoveRowAt: IndexPath(row: 0, section: 1)))
+    XCTAssertTrue(table.visibleCells.contains { $0.showsReorderControl })
+    // Exercise the native table's visual move and its data-source commit.
+    // This hosted test does not synthesize a physical drag or an AX action.
+    table.moveRow(at: source, to: target)
+    controller.tableView(table, moveRowAt: source, to: target)
+    XCTAssertEqual(sortedIds[target.row], movingId)
+    controller.setEditing(false, animated: false)
+    XCTAssertFalse(table.isEditing)
+    XCTAssertEqual(BMCDefaultViewModel().category(at: target.row).categoryId, movingId)
+  }
+
+  private func findTable(in view: UIView) -> UITableView? {
+    if let table = view as? UITableView { return table }
+    for subview in view.subviews {
+      if let table = findTable(in: subview) { return table }
+    }
+    return nil
+  }
+}
