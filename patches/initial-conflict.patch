+final class SynchronizationFileWriterInitialConflictTests: XCTestCase {
+  private let fileManager = FileManager.default
+  private var rootURL: URL!
+  private var localDirectory: URL { rootURL.appendingPathComponent("local", isDirectory: true) }
+  private var cloudDirectory: URL { rootURL.appendingPathComponent("cloud", isDirectory: true) }
+  private var localURL: URL { localDirectory.appendingPathComponent("Collection.kml") }
+  private var cloudURL: URL { cloudDirectory.appendingPathComponent("Collection.kml") }
+  private let localData = Data("<kml><Document><name>A</name></Document></kml>".utf8)
+  private let changedData = Data("<kml><Document><name>B</name></Document></kml>".utf8)
+
+  override func setUpWithError() throws {
+    try super.setUpWithError()
+    rootURL = fileManager.temporaryDirectory.appendingPathComponent(UUID().uuidString, isDirectory: true)
+    try fileManager.createDirectory(at: localDirectory, withIntermediateDirectories: true)
+    try fileManager.createDirectory(at: cloudDirectory, withIntermediateDirectories: true)
+  }
+
+  override func tearDownWithError() throws {
+    defer { rootURL = nil }
+    if let rootURL { try fileManager.removeItem(at: rootURL) }
+    try super.tearDownWithError()
+  }
+
+  @MainActor
+  func testEqualFilesWithDifferentDatesDoNotCreateConflictCopy() async throws {
+    try prepareFiles(cloudData: localData)
+    try await synchronize()
+    XCTAssertEqual(try conflictCopies().count, 0)
+    XCTAssertEqual(try Data(contentsOf: localURL), localData)
+  }
+
+  @MainActor
+  func testDifferentFilesPreserveLocalCopyBeforeCloudReplacement() async throws {
+    try prepareFiles(cloudData: changedData)
+    try await synchronize()
+    let copies = try conflictCopies()
+    XCTAssertEqual(copies.count, 1)
+    let copy = try XCTUnwrap(copies.first)
+    XCTAssertEqual(try Data(contentsOf: copy), localData)
+    XCTAssertEqual(try Data(contentsOf: localURL), changedData)
+  }
+
+  @MainActor
+  func testEqualFilesDoNotOverwriteExistingConflictCopy() async throws {
+    try prepareFiles(cloudData: localData)
+    let copy = localDirectory.appendingPathComponent("Collection_1_\(UIDevice.current.name).kml")
+    try changedData.write(to: copy)
+    try await synchronize()
+    XCTAssertEqual(try conflictCopies().count, 1)
+    XCTAssertEqual(try Data(contentsOf: copy), changedData)
+  }
+
+  private func prepareFiles(cloudData: Data) throws {
+    try localData.write(to: localURL)
+    try cloudData.write(to: cloudURL)
+    try fileManager.setAttributes([.modificationDate: Date(timeIntervalSince1970: 200)], ofItemAtPath: localURL.path)
+    try fileManager.setAttributes([.modificationDate: Date(timeIntervalSince1970: 100)], ofItemAtPath: cloudURL.path)
+  }
+
+  private func conflictCopies() throws -> [URL] {
+    try fileManager.contentsOfDirectory(at: localDirectory, includingPropertiesForKeys: nil)
+      .filter { $0.lastPathComponent != "Collection.kml" && $0.pathExtension == "kml" }
+  }
+
+  @MainActor
+  func testMetadataURLSelectsTheFileThatWillActuallyBeTransferred() async throws {
+    try prepareFiles(cloudData: localData)
+    let movedDirectory = cloudDirectory.appendingPathComponent("moved", isDirectory: true)
+    try fileManager.createDirectory(at: movedDirectory, withIntermediateDirectories: true)
+    let movedFile = movedDirectory.appendingPathComponent("Collection.kml")
+    try changedData.write(to: movedFile)
+    try await synchronize(cloudFileURL: movedFile)
+    let copies = try conflictCopies()
+    XCTAssertEqual(copies.count, 1)
+    XCTAssertEqual(try Data(contentsOf: XCTUnwrap(copies.first)), localData)
+    XCTAssertEqual(try Data(contentsOf: localURL), changedData)
+  }
+
+  @MainActor
+  func testUnavailableCloudComparisonStillPreservesLocalData() async throws {
+    try prepareFiles(cloudData: changedData)
+    try fileManager.removeItem(at: cloudURL)
+    try await synchronize(afterInitialConflict: { try self.changedData.write(to: self.cloudURL) })
+    let copies = try conflictCopies()
+    XCTAssertEqual(copies.count, 1)
+    XCTAssertEqual(try Data(contentsOf: XCTUnwrap(copies.first)), localData)
+    XCTAssertEqual(try Data(contentsOf: localURL), changedData)
+  }
+
+  @MainActor
+  private func synchronize(cloudFileURL: URL? = nil, afterInitialConflict: (() throws -> Void)? = nil) async throws {
+    let local = try LocalMetadataItem(fileUrl: localURL)
+    let cloud = CloudMetadataItem(fileName: "Collection.kml", fileUrl: cloudFileURL ?? cloudURL,
+                                  isDownloaded: true, percentDownloaded: 100,
+                                  lastModificationDate: 100, downloadingError: nil,
+                                  uploadingError: nil, hasUnresolvedConflicts: false)
+    let resolver = iCloudSynchronizationStateResolver(isInitialSynchronization: true)
+    let events = resolver.resolveEvent(.didFinishGatheringLocalContents([local]))
+      + resolver.resolveEvent(.didFinishGatheringCloudContents([cloud]))
+    XCTAssertTrue(events.contains { if case .resolveInitialSynchronizationConflict = $0 { return true }; return false })
+    let completed = expectation(description: "Synchronization events completed")
+    completed.expectedFulfillmentCount = events.count
+    completed.assertForOverFulfill = true
+    let writer = SynchronizationFileWriter(localDirectoryUrl: localDirectory, cloudDirectoryUrl: cloudDirectory)
+    for event in events {
+      let isInitialConflict: Bool = { if case .resolveInitialSynchronizationConflict = event { return true }; return false }()
+      writer.processEvent(event) { result in
+        if isInitialConflict {
+          do { try afterInitialConflict?() } catch { XCTFail(String(describing: error)) }
+        }
+        XCTAssertTrue(Thread.isMainThread)
+        if case .failure(let error) = result { XCTFail(String(describing: error)) }
+        completed.fulfill()
+      }
+    }
+    await fulfillment(of: [completed], timeout: 10)
+    withExtendedLifetime(writer) {}
+  }
+}
