+  @MainActor
+  func testTopEditStartsManualOrderWithDeleteAndReorderControls() async throws {
+    let category = try XCTUnwrap(category)
+    try await withHostedItemList { controller, table in
+      XCTAssertFalse(controller.isEditing)
+      try assertItemEditButton(controller, editing: false)
+      let initialSortingType = manager.lastSortingType(category.categoryId)
+      let firstRow = IndexPath(row: 0, section: 0)
+      // Ordinary swipe editing must not enter manual ordering through the Edit override.
+      controller.tableView(table, willBeginEditingRowAt: firstRow)
+      XCTAssertEqual(manager.lastSortingType(category.categoryId), initialSortingType)
+      XCTAssertFalse(controller.tableView(table, canMoveRowAt: firstRow))
+      XCTAssertFalse(table.isEditing)
+      controller.tableView(table, didEndEditingRowAt: firstRow)
+      try assertItemEditButton(controller, editing: false)
+      try tapItemEditButton(controller)
+      XCTAssertTrue(controller.isEditing)
+      XCTAssertTrue(table.isEditing)
+      try assertItemEditButton(controller, editing: true)
+      // A delayed swipe lifecycle callback must not reset the explicit Edit session.
+      controller.tableView(table, willBeginEditingRowAt: IndexPath(row: 0, section: 0))
+      controller.tableView(table, didEndEditingRowAt: nil)
+      XCTAssertTrue(controller.isEditing)
+      XCTAssertTrue(table.isEditing)
+      try assertItemEditButton(controller, editing: true)
+      XCTAssertEqual(manager.lastSortingType(category.categoryId), .manual)
+      XCTAssertTrue(table.visibleCells.contains { $0.showsReorderControl })
+      let section = try XCTUnwrap((0..<table.numberOfSections).first { section in
