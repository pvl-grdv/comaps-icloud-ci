+        table.numberOfRows(inSection: section) > 0 &&
+          controller.tableView(table, canMoveRowAt: IndexPath(row: 0, section: section))
+      })
+      controller.tableView(table, commit: .delete, forRowAt: IndexPath(row: 0, section: section))
+      XCTAssertFalse(controller.isEditing)
+      XCTAssertFalse(table.isEditing)
+      // Re-entering must build a new complete permutation, without the deleted ID.
+      try tapItemEditButton(controller)
+      XCTAssertTrue(controller.isEditing)
+      try tapItemEditButton(controller)
+    }
+    let sections = await sortedSections(category.categoryId)
