+      })
+      XCTAssertEqual(controller.tableView(table, editingStyleForRowAt: IndexPath(row: 0, section: section)), .delete)
+      XCTAssertTrue(controller.tableView(table, shouldIndentWhileEditingRowAt: IndexPath(row: 0, section: section)))
+    }
+  }
