+UNIT_CLASS_TEST(Runner, ManualItemOrder_AppendsNormallyCreatedBookmarks)
+{
+  BookmarkManager manager(BM_CALLBACKS);
+  manager.EnableTestMode(true);
+  df::VisualParams::Init(1.0, 1024);
+  auto const category = CreateManualItemsCategory(manager, "manual normal creation", 2, 0);
+  auto const filePath = manager.GetCategoryFileName(category.m_groupId);
+  SCOPE_GUARD(fileDeleter, [&]() { (void)base::DeleteFileX(filePath); });
+  TEST(manager.SetManualItemOrder(category.m_groupId, category.m_bookmarks, {}), ());
+  for (size_t i = 0; i < 2; ++i)
+  {
+    auto session = manager.GetEditSession();
+    kml::BookmarkData data;
+    kml::SetDefaultStr(data.m_name, "NewBookmark" + std::to_string(i));
+    data.m_point = m2::PointD(0, 0);
+    auto const * bookmark = session.CreateBookmark(std::move(data), category.m_groupId);
+    auto const property = bookmark->GetData().m_properties.find("comaps:itemOrder");
+    TEST(property != bookmark->GetData().m_properties.end(), ());
+    TEST_EQUAL(property->second, std::to_string(i + 2), ());
+  }
+  auto const expected = ManualItemNames{{"Bookmark0", "Bookmark1", "NewBookmark0", "NewBookmark1"}, {}};
+  TEST_EQUAL(GetManualItemNames(manager, category.m_groupId), expected, ());
+  auto const reloaded = LoadManualItemsFile(manager, filePath);
+  TEST_EQUAL(GetManualItemNames(manager, reloaded), expected, ());
+}
+
+UNIT_CLASS_TEST(Runner, ManualItemOrder_UndoKeepsOriginalBookmarkPosition)
+{
+  BookmarkManager manager(BM_CALLBACKS);
+  manager.EnableTestMode(true);
+  df::VisualParams::Init(1.0, 1024);
+  auto const category = CreateManualItemsCategory(manager, "manual undo position", 2, 0);
+  auto const filePath = manager.GetCategoryFileName(category.m_groupId);
+  SCOPE_GUARD(fileDeleter, [&]() { (void)base::DeleteFileX(filePath); });
+  TEST(manager.SetManualItemOrder(category.m_groupId, category.m_bookmarks, {}), ());
+  {
+    auto session = manager.GetEditSession();
+    session.DeleteBookmark(category.m_bookmarks.front());
+  }
+  {
+    auto session = manager.GetEditSession();
+    auto const * recovered = session.CreateBookmark(kml::BookmarkData{}, category.m_groupId);
+    TEST_EQUAL(recovered->GetId(), category.m_bookmarks.front(), ());
+    TEST_EQUAL(recovered->GetData().m_properties.at("comaps:itemOrder"), "0", ());
+  }
+  auto const expected = ManualItemNames{{"Bookmark0", "Bookmark1"}, {}};
+  TEST_EQUAL(GetManualItemNames(manager, category.m_groupId), expected, ());
+}
