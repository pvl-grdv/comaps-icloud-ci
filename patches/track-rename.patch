+UNIT_CLASS_TEST(Runner, TrackRename_AutoSave)
+{
+  BookmarkManager bmManager(BM_CALLBACKS);
+  bmManager.EnableTestMode(true);
+
+  auto const catId = bmManager.CreateBookmarkCategory("track rename persistence");
+  kml::TrackId trackId = kml::kInvalidTrackId;
+  {
+    auto editSession = bmManager.GetEditSession();
+    kml::TrackData trackData;
+    kml::SetDefaultStr(trackData.m_name, "original track name");
+    trackData.m_layers.emplace_back();
+    trackData.m_geometry.AddLine({{{0.0, 0.0}, 1}, {{1.0, 0.0}, 2}});
+    trackData.m_geometry.AddTimestamps({});
+    auto const * track = editSession.CreateTrack(std::move(trackData));
+    trackId = track->GetId();
+    editSession.AttachTrack(trackId, catId);
+  }
+
+  auto const fileName = bmManager.GetCategoryFileName(catId);
+  SCOPE_GUARD(fileDeleter, [&]() { (void)base::DeleteFileX(fileName); });
+  auto checkPersistedName = [&](std::string const & expected)
+  {
+    auto const fileData = LoadKmlFile(fileName, GetActiveKmlFileType());
+    TEST(fileData != nullptr, ());
+    TEST_EQUAL(fileData->m_tracksData.size(), 1, ());
+    TEST_EQUAL(kml::GetDefaultStr(fileData->m_tracksData.front().m_name), expected, ());
+  };
+
+  checkPersistedName("original track name");
+  {
+    auto editSession = bmManager.GetEditSession();
+    editSession.GetTrackForEdit(trackId)->SetName("renamed track");
+    TEST_EQUAL(bmManager.GetTrack(trackId)->GetName(), "renamed track", ());
+    checkPersistedName("original track name");
+  }
+  checkPersistedName("renamed track");
+
+  {
+    auto editSession = bmManager.GetEditSession();
+    editSession.GetTrackForEdit(trackId)->SetName("renamed again");
+  }
+  checkPersistedName("renamed again");
+}
+
+
