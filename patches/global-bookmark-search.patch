diff --git a/iphone/Maps/Tests/Bookmarks/Categories/BMCSearchViewModelTests.swift b/iphone/Maps/Tests/Bookmarks/Categories/BMCSearchViewModelTests.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Tests/Bookmarks/Categories/BMCSearchViewModelTests.swift
@@ -0,0 +1,159 @@
+import XCTest
+@testable import CoMaps__Debug_
+
+final class BMCSearchViewModelTests: XCTestCase {
+  private var service: BMCSearchServiceMock!
+  private var model: BMCSearchViewModel!
+
+  override func setUp() {
+    super.setUp()
+    service = BMCSearchServiceMock()
+    model = BMCSearchViewModel(service: service)
+  }
+
+  func testRepeatedStartAndStopPrepareAndReleaseOnlyOnce() {
+    model.start()
+    model.start()
+    model.stop()
+    model.stop()
+    XCTAssertEqual(service.prepareCount, 1)
+    XCTAssertEqual(service.releaseCount, 1)
+    XCTAssertTrue(service.requests.isEmpty)
+  }
+
+  func testResultsAreGroupedByCategoryIdentityInResultOrder() {
+    model.start()
+    model.search("park")
+    let first = result(id: 1, category: 10, name: "Same folder")
+    let second = result(id: 2, category: 20, name: "Same folder")
+    let third = result(id: 3, category: 10, name: "Same folder")
+    service.requests[0].completion([first, second, third])
+    XCTAssertEqual(model.sections.map(\.categoryId), [10, 20])
+    XCTAssertEqual(model.sections[0].results.map(\.item), [.bookmark(1), .bookmark(3)])
+    XCTAssertEqual(model.sections[1].results.map(\.item), [.bookmark(2)])
+    XCTAssertFalse(model.isSearching)
+  }
+
+  func testEarlierQueryCannotReplaceCurrentResults() {
+    model.start()
+    model.search("old")
+    model.search("new")
+    service.requests[1].completion([result(id: 2, category: 10)])
+    service.requests[0].completion([result(id: 1, category: 10)])
+    XCTAssertEqual(model.sections[0].results.map(\.item), [.bookmark(2)])
+  }
+
+  func testDismissedSearchIgnoresPendingResults() {
+    model.start()
+    model.search("park")
+    model.stop()
+    service.requests[0].completion([result(id: 1, category: 10)])
+    XCTAssertTrue(model.sections.isEmpty)
+    XCTAssertFalse(model.isActive)
+    XCTAssertFalse(model.isSearching)
+  }
+
+  func testClearingQueryClearsResultsAndInvalidatesOldCompletion() {
+    model.start()
+    model.search("park")
+    service.requests[0].completion([result(id: 1, category: 10)])
+    model.search(" \n ")
+    service.requests[0].completion([result(id: 2, category: 10)])
+    XCTAssertTrue(model.sections.isEmpty)
+    XCTAssertEqual(service.requests.count, 1)
+    XCTAssertFalse(model.isSearching)
+  }
+
+  func testRefreshReindexesAndRepeatsCurrentQuery() {
+    model.start()
+    model.search("park")
+    model.refresh()
+    XCTAssertEqual(service.prepareCount, 2)
+    XCTAssertEqual(service.requests.map(\.text), ["park", "park"])
+    service.requests[0].completion([result(id: 1, category: 10)])
+    XCTAssertTrue(model.sections.isEmpty)
+    service.requests[1].completion([result(id: 2, category: 20)])
+    XCTAssertEqual(model.sections[0].categoryId, 20)
+  }
+
+  func testInactiveRefreshDoesNotAcquireIndex() {
+    model.refresh()
+    XCTAssertEqual(service.prepareCount, 0)
+    XCTAssertTrue(service.requests.isEmpty)
+  }
+
+  func testRestartDoesNotAcceptCompletionFromPreviousSession() {
+    model.start()
+    model.search("park")
+    model.stop()
+    model.start()
+    model.search("park")
+    service.requests[0].completion([result(id: 1, category: 10)])
+    XCTAssertTrue(model.sections.isEmpty)
+    service.requests[1].completion([result(id: 2, category: 20)])
+    XCTAssertEqual(model.sections[0].results[0].item, .bookmark(2))
+  }
+
+  func testSelectingDeletedResultRefreshesInsteadOfReturningStaleIdentity() {
+    model.start()
+    model.search("park")
+    service.requests[0].completion([result(id: 1, category: 10)])
+    service.selectionResolver = { _ in nil }
+    XCTAssertNil(model.selectResult(section: 0, row: 0))
+    XCTAssertEqual(service.requests.count, 2)
+  }
+
+  func testBookmarkAndTrackWithSameNumericIdRemainDistinct() {
+    model.start()
+    model.search("park")
+    let bookmark = result(id: 1, category: 10)
+    let track = BMCSearchResult(item: .track(1), categoryId: 10,
+                                categoryName: "Folder", name: "Track", subtitle: nil)
+    service.requests[0].completion([bookmark, track])
+    XCTAssertEqual(model.sections[0].results.map(\.item), [.bookmark(1), .track(1)])
+    XCTAssertEqual(model.selectResult(section: 0, row: 1)?.item, .track(1))
+  }
+
+  func testSelectingMovedResultUsesItsCurrentCategory() {
+    model.start()
+    model.search("park")
+    service.requests[0].completion([result(id: 1, category: 10)])
+    service.selectionResolver = { old in
+      BMCSearchResult(item: old.item, categoryId: 20, categoryName: "Moved",
+                      name: old.name, subtitle: old.subtitle)
+    }
+    XCTAssertEqual(model.selectResult(section: 0, row: 0)?.categoryId, 20)
+  }
+
+  private func result(id: MWMMarkID, category: MWMMarkGroupID, name: String = "Folder") -> BMCSearchResult {
+    BMCSearchResult(item: .bookmark(id), categoryId: category, categoryName: name,
+                    name: "Result", subtitle: nil)
+  }
+}
