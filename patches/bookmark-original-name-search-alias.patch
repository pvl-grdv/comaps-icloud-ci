+UNIT_CLASS_TEST(SavedItemsIndexTest, OriginalAndCustomNamesSurviveUpdates)
+{
+  auto data = MakeBookmarkData("Double R Diner", "2R Diner", "", {});
+  auto const expected = ItemResults{{{ItemKind::Bookmark, 7}, 10}};
+  TEST(Replace({{{ItemKind::Bookmark, 7}, 10, Data(data)}}), ());
+  TEST_EQUAL(Search("double"), expected, ());
+  TEST_EQUAL(Search("2r"), expected, ());
+
+  kml::SetDefaultStr(data.m_customName, "Renamed Label");
+  TEST(Replace({{{ItemKind::Bookmark, 7}, 10, Data(data)}}), ());
+  TEST_EQUAL(Search("double"), expected, ());
+  TEST_EQUAL(Search("renamed"), expected, ());
+
+  kml::SetDefaultStr(data.m_name, "Glacier Cabin");
+  TEST(Replace({{{ItemKind::Bookmark, 7}, 10, Data(data)}}), ());
+  TEST(Search("double").empty(), ());
+  TEST_EQUAL(Search("glacier"), expected, ());
+  TEST_EQUAL(Search("renamed"), expected, ());
+}
