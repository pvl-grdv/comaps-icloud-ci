+UNIT_CLASS_TEST(Runner, Bookmarks_ReloadReplacesCompilations)
+{
+  BookmarkManager bmManager(BM_CALLBACKS);
+  bmManager.EnableTestMode(true);
+  auto const filePath = base::JoinPath(GetBookmarksDirectory(), "reload_compilations.kml");
+  auto load = [&](std::string const & name, std::string const & path)
+  {
+    auto data = LoadKmlData(MemReader(kmlString, std::strlen(kmlString)), KmlFileType::Text);
+    TEST(data, ());
+    data->m_categoryData.m_lastModified = kml::TimestampClock::from_time_t(1000);
+    kml::CategoryData compilation;
+    compilation.m_compilationId = 42;
+    compilation.m_type = kml::CompilationType::Collection;
+    kml::SetDefaultStr(compilation.m_name, name);
+    data->m_compilationsData.push_back(std::move(compilation));
+    data->m_bookmarksData.front().m_compilations.push_back(42);
+    BookmarkManager::KMLDataCollection collection;
+    collection.emplace_back(path, std::move(data));
+    bmManager.CreateCategories(std::move(collection));
+  };
+
+  load("First collection", filePath);
+  auto const groupId = bmManager.GetCategoryByFileName(filePath);
+  TEST_NOT_EQUAL(groupId, kml::kInvalidMarkGroupId, ());
+  auto children = bmManager.GetChildrenCollections(groupId);
+  TEST_EQUAL(children.size(), 1, ());
+  auto oldChildId = children.front();
+  load("Other collection", base::JoinPath(GetBookmarksDirectory(), "reload_other.kml"));
+  bmManager.SetCategorySortType(BookmarkManager::CategorySortType::Manual);
+  bmManager.MoveCategoryToPosition(groupId, 1);
+  auto const categoryOrder = bmManager.GetSortedBmGroupIdList();
+  TEST_EQUAL(categoryOrder.size(), 2, ());
+  TEST_EQUAL(categoryOrder.back(), groupId, ());
+
+  for (auto const & name : {"Second collection", "Third collection"})
+  {
+    load(name, filePath);
+    TEST_EQUAL(bmManager.GetSortedBmGroupIdList(), categoryOrder, ());
+    TEST_EQUAL(bmManager.GetCategoryByFileName(filePath), groupId, ());
+    TEST_EQUAL(bmManager.GetCategoryName(groupId), "MapName", ());
+    TEST(!bmManager.HasBmCategory(oldChildId), ());
+    children = bmManager.GetChildrenCollections(groupId);
+    TEST_EQUAL(children.size(), 1, ());
+    auto const childId = children.front();
+    TEST_NOT_EQUAL(childId, oldChildId, ());
+    TEST_EQUAL(bmManager.GetCategoryData(childId).m_id, childId, ());
+    TEST_EQUAL(bmManager.GetCategoryName(childId), name, ());
+    TEST_EQUAL(bmManager.GetUserMarkIds(childId).size(), 1, ());
+    auto const markId = *bmManager.GetUserMarkIds(childId).begin();
+    TEST(bmManager.HasBookmark(markId), ());
+    TEST_EQUAL(bmManager.GetBookmark(markId)->GetCompilations().front(), childId, ());
+    oldChildId = childId;
+  }
+}
