+class IncomingTestGuiLoop final : public base::TaskLoop
+{
+public:
+  PushResult Push(Task && task) override
+  {
+    { std::lock_guard lock(m_mutex); m_tasks.push_back(std::move(task)); }
+    m_ready.notify_one();
+    return {true, kNoId};
+  }
+  PushResult Push(Task const & task) override { return Push(Task(task)); }
+  template <typename Predicate> void PumpUntil(Predicate && done)
+  {
+    auto const deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (!done())
+    {
+      Task task;
+      {
+        std::unique_lock lock(m_mutex);
+        TEST(m_ready.wait_until(lock, deadline, [&]() { return !m_tasks.empty(); }), ("GUI callback timeout"));
+        task = std::move(m_tasks.front());
+        m_tasks.pop_front();
+      }
+      task();
+    }
+  }
+  void Drain()
+  {
+    for (;;)
+    {
+      Task task;
+      {
+        std::lock_guard lock(m_mutex);
+        if (m_tasks.empty()) return;
+        task = std::move(m_tasks.front());
+        m_tasks.pop_front();
+      }
+      task();
+    }
+  }
+private:
+  std::mutex m_mutex;
+  std::condition_variable m_ready;
+  std::deque<Task> m_tasks;
+};
+
+void DrainIncomingFileWorker()
+{
+  auto drained = std::make_shared<std::promise<void>>();
+  auto future = drained->get_future();
+  GetPlatform().RunTask(Platform::Thread::File, [drained]() { drained->set_value(); });
+  TEST(future.wait_for(std::chrono::seconds(10)) == std::future_status::ready, ("File worker timeout"));
+}
+
+class IncomingFileBlocker
+{
+public:
+  IncomingFileBlocker()
+  {
+    auto entered = std::make_shared<std::promise<void>>();
+    auto enteredFuture = entered->get_future();
+    auto releaseFuture = m_release->get_future().share();
+    GetPlatform().RunTask(Platform::Thread::File, [entered, releaseFuture]()
+    { entered->set_value(); releaseFuture.wait(); });
+    TEST(enteredFuture.wait_for(std::chrono::seconds(10)) == std::future_status::ready, ());
+  }
+  ~IncomingFileBlocker() { Release(); }
+  void Release() { if (!m_released) { m_released = true; m_release->set_value(); } }
+private:
+  std::shared_ptr<std::promise<void>> m_release = std::make_shared<std::promise<void>>();
+  bool m_released = false;
+};
