+void BookmarkManager::CommitIncomingBookmark(std::shared_ptr<IncomingBookmark> const & incoming,
+                                              KMLDataCollectionPtr const & collection)
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  if (m_openedEditSessionsCount != 0 && !collection->empty())
+  {
+    std::weak_ptr<bool> const lifetime = m_incomingLifetime;
+    m_incomingAfterEditSession = [this, incoming, lifetime, collection]()
+    {
+      if (lifetime.expired())
+        incoming->Complete(false);
+      else
+        CommitIncomingBookmark(incoming, collection);
+    };
+    return;
+  }
+  bool success = false;
+  auto const currentId = GetCategoryByFileName(incoming->m_filePath);
+  auto const state = currentId == kml::kInvalidMarkGroupId
+      ? std::shared_ptr<BookmarkCategory::FileSaveState>{} : GetBmCategory(currentId)->m_fileSaveState;
+  bool const superseded = state != incoming->m_saveState ||
+      (state && (state->m_cancelled || state->m_localEditRevision != incoming->m_localEditRevision)) ||
+      (!state && incoming->m_targetExisted && !Platform::IsFileExistsByFullPath(incoming->m_filePath));
+  if (superseded)
+  {
+    success = true;
+  }
+  else if (!collection->empty())
+  {
+    std::unique_lock<std::mutex> saveLock;
+    if (state)
+      saveLock = std::unique_lock(state->m_mutex);
+    success = base::RenameFileX(incoming->m_snapshotPath, incoming->m_filePath);
+    if (saveLock.owns_lock())
+      saveLock.unlock();
+    if (success)
+      CreateCategories(std::move(*collection), true /* autoSave */);
+  }
+  AdvanceBookmarkLoadingQueue();
+  incoming->Complete(success);
+}
