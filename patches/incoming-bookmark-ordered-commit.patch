+void BookmarkManager::ApplyIncomingBookmark(std::string const & filePath, std::string const & snapshotPath,
+                                            std::function<void(bool)> completion)
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  CHECK(static_cast<bool>(completion), ());
+  if (m_needTeardown || filePath.empty() || snapshotPath.empty() || filePath == snapshotPath)
+  {
+    completion(false);
+    return;
+  }
+  auto incoming = std::make_shared<IncomingBookmark>();
+  incoming->m_filePath = filePath;
+  incoming->m_snapshotPath = snapshotPath;
+  incoming->m_targetExisted = Platform::IsFileExistsByFullPath(filePath);
+  incoming->m_completion = std::move(completion);
+  auto const groupId = GetCategoryByFileName(filePath);
+  if (groupId != kml::kInvalidMarkGroupId)
+  {
+    incoming->m_saveState = GetBmCategory(groupId)->m_fileSaveState;
+    incoming->m_localEditRevision = incoming->m_saveState->m_localEditRevision;
+  }
+  if (!m_loadBookmarksFinished || m_asyncLoadingInProgress)
+  {
+    m_bookmarkLoadingQueue.emplace_back(filePath, false, false);
+    m_bookmarkLoadingQueue.back().m_incoming = std::move(incoming);
+    return;
+  }
+  NotifyAboutStartAsyncLoading();
+  ApplyIncomingBookmarkRoutine(incoming);
+}
+
+void BookmarkManager::ApplyIncomingBookmarkRoutine(std::shared_ptr<IncomingBookmark> const & incoming)
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  if (m_needTeardown)
+  {
+    incoming->Complete(false);
+    return;
+  }
+  auto const groupId = GetCategoryByFileName(incoming->m_filePath);
+  if (!incoming->m_saveState && groupId != kml::kInvalidMarkGroupId)
+  {
+    auto const state = GetBmCategory(groupId)->m_fileSaveState;
+    if (state->m_localEditRevision != 0)
+    {
+      AdvanceBookmarkLoadingQueue();
+      incoming->Complete(true);
+      return;
+    }
+    incoming->m_saveState = state;
+  }
+
+  std::weak_ptr<bool> const lifetime = m_incomingLifetime;
+  GetPlatform().RunTask(Platform::Thread::File, [this, incoming, lifetime]()
+  {
+    auto collection = std::make_shared<KMLDataCollection>();
+    auto const ext = GetLowercaseFileExt(incoming->m_filePath);
+    std::unique_ptr<kml::FileData> data;
+    try
+    {
+      if (ext == kKmlExtension)
+        data = LoadKmlData(FileReader(incoming->m_snapshotPath), KmlFileType::Text);
+      else if (ext == kGpxExtension)
+        data = LoadKmlData(FileReader(incoming->m_snapshotPath), KmlFileType::Gpx);
+      if (data)
+        FillEmptyNames(data, incoming->m_filePath);
+    }
+    catch (std::exception const & e)
+    {
+      LOG(LWARNING, ("Incoming bookmark snapshot loading failed:", e.what()));
+      data.reset();
+    }
+    if (data)
+      collection->emplace_back(incoming->m_filePath, std::move(data));
+
+    GetPlatform().RunTask(Platform::Thread::Gui, [this, incoming, lifetime, collection]()
+    {
+      if (lifetime.expired())
+      {
+        incoming->Complete(false);
+        return;
+      }
+      CommitIncomingBookmark(incoming, collection);
+    });
+  });
+}
