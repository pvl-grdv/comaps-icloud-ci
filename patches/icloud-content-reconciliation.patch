+    XCTAssertEqual(item.lastModificationDate, 100.7, accuracy: 0.000001)
+    XCTAssertEqual(item.size, 42)
+    XCTAssertTrue(item.isDownloaded)
+    XCTAssertFalse(item.hasUnresolvedConflicts)
