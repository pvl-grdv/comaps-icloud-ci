+  func testItemWithoutSizeIsPresentButNotActionable() {
+    let observation = CloudMetadataItem.observation(from: MetadataItemMock([
+      NSMetadataItemFSNameKey: "file.kml",
+      NSMetadataItemURLKey: URL(fileURLWithPath: "/cloud/file.kml"),
+      NSMetadataItemFSContentChangeDateKey: Date(timeIntervalSince1970: 100),
+      NSMetadataUbiquitousItemDownloadingStatusKey: NSMetadataUbiquitousItemDownloadingStatusCurrent,
+    ]))
+    guard case .unusable(_, _, let missingAttributes) = observation else {
+      return XCTFail("A missing size cannot form a reliable content identity")
+    }
+    XCTAssertTrue(missingAttributes.contains(NSMetadataItemFSSizeKey))
+  }
