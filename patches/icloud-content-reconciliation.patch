-
-  private func prepareFiles(cloudData: Data) throws {
-    try localData.write(to: localURL)
-    try cloudData.write(to: cloudURL)
-    try fileManager.setAttributes([.modificationDate: Date(timeIntervalSince1970: 200)], ofItemAtPath: localURL.path)
-    try fileManager.setAttributes([.modificationDate: Date(timeIntervalSince1970: 100)], ofItemAtPath: cloudURL.path)
-  }
-
-  private func conflictCopies() throws -> [URL] {
-    try fileManager.contentsOfDirectory(at: localDirectory, includingPropertiesForKeys: nil)
-      .filter { $0.lastPathComponent != "Collection.kml" && $0.pathExtension == "kml" }
-  }
-
-  @MainActor
-  func testMetadataURLSelectsTheFileThatWillActuallyBeTransferred() async throws {
