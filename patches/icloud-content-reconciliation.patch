@@ -0,0 +1,152 @@
+import XCTest
+@testable import CoMaps__Debug_
+
+final class SynchronizedStateStoreTests: XCTestCase, LocalDirectoryMonitorDelegate {
+  private let directoryURL = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+  private var monitor: FileSystemDispatchSourceMonitor?
+  private var onSnapshot: (() -> Void)?
+
+  override func tearDownWithError() throws {
+    onSnapshot = nil
+    monitor?.stop()
+    monitor = nil
+    try? FileManager.default.removeItem(at: directoryURL)
+    try super.tearDownWithError()
+  }
+
+  @MainActor
+  func testWrittenCommonBaseIsRestoredAfterReopening() async throws {
+    let fileManager = StateStoreFileManager(directory: directoryURL)
+    let store = FileSynchronizedStateStore(fileManager: fileManager)
+    try await startObserving()
+    let expected = state("A")
+    let persisted = expectDiskState(fileManager: fileManager, expected: expected)
+
+    store.setState(expected, for: "file.kml")
+    await fulfillment(of: [persisted], timeout: 5)
+
+    let reopened = FileSynchronizedStateStore(fileManager: fileManager)
+    XCTAssertEqual(reopened.state(for: "file.kml"), expected)
+  }
+
+  @MainActor
+  func testChangedAccountPersistsOnlyItsOwnCommonBase() async throws {
+    let fileManager = StateStoreFileManager(directory: directoryURL)
+    let store = FileSynchronizedStateStore(fileManager: fileManager)
+    try await startObserving()
+    let accountA = try identity("Account A")
+    let accountB = try identity("Account B")
+    let firstWrite = expectDiskState(fileManager: fileManager, expected: state("A"))
+    store.resetIfCloudIdentityChanged(accountA)
+    store.setState(state("A"), for: "file.kml")
+    await fulfillment(of: [firstWrite], timeout: 5)
+
+    let secondWrite = expectDiskState(fileManager: fileManager, expected: state("B"))
+    store.resetIfCloudIdentityChanged(accountB)
+    XCTAssertNil(store.state(for: "file.kml"))
+    store.setState(state("B"), for: "file.kml")
+    await fulfillment(of: [secondWrite], timeout: 5)
+
+    let reopened = FileSynchronizedStateStore(fileManager: fileManager)
+    let sameAccountB = try identity("Account B")
+    XCTAssertNotEqual(sameAccountB, accountB)
+    reopened.resetIfCloudIdentityChanged(sameAccountB)
+    XCTAssertEqual(reopened.state(for: "file.kml"), state("B"))
+
+    let resetWrite = expectDiskState(fileManager: fileManager, expected: nil)
+    reopened.resetIfCloudIdentityChanged(accountA)
+    XCTAssertNil(reopened.state(for: "file.kml"))
+    await fulfillment(of: [resetWrite], timeout: 5)
+    XCTAssertNil(FileSynchronizedStateStore(fileManager: fileManager).state(for: "file.kml"))
+  }
+
+  @MainActor
+  private func startObserving() async throws {
+    let initial = expectation(description: "State directory is observed")
+    onSnapshot = { [weak self] in
+      self?.onSnapshot = nil
+      initial.fulfill()
+    }
+    monitor = try FileSystemDispatchSourceMonitor(fileManager: .default, directory: directoryURL)
+    monitor?.delegate = self
+    monitor?.start()
+    await fulfillment(of: [initial], timeout: 5)
+  }
+
+  @MainActor
+  private func expectDiskState(fileManager: FileManager, expected: SynchronizedFileState?) -> XCTestExpectation {
+    let persisted = expectation(description: "Common base is persisted")
+    onSnapshot = { [weak self] in
+      guard FileSynchronizedStateStore(fileManager: fileManager).state(for: "file.kml") == expected else { return }
+      self?.onSnapshot = nil
+      persisted.fulfill()
+    }
+    return persisted
+  }
+
+  private func state(_ content: String) -> SynchronizedFileState {
+    SynchronizedFileState(fingerprint: Fingerprint(hashing: Data(content.utf8)),
+                          localIdentity: FileIdentity(modificationDate: 1, size: Int64(content.utf8.count)),
+                          cloudIdentity: FileIdentity(modificationDate: 2, size: Int64(content.utf8.count)))
+  }
+
+  private func identity(_ account: String) throws -> Data {
+    try NSKeyedArchiver.archivedData(withRootObject: SyntheticSynchronizationAccountToken(logicalID: account),
+                                    requiringSecureCoding: false)
+  }
+
+  func didReceiveLocalSnapshot(_: LocalSnapshot) { onSnapshot?() }
+
+  func didReceiveLocalMonitorError(_ error: Error) {
+    XCTFail("State directory monitor failed: \(error)")
+  }
+}
+
+private final class StateStoreFileManager: FileManager {
+  private let directory: URL
+
+  init(directory: URL) {
+    self.directory = directory
+    super.init()
+  }
+
+  override func urls(for _: FileManager.SearchPathDirectory,
+                     in _: FileManager.SearchPathDomainMask) -> [URL] {
+    [directory]
+  }
+}
+
+@objc(SyntheticSynchronizationAccountToken)
+final class SyntheticSynchronizationAccountToken: NSObject, NSCoding, NSCopying {
+  let logicalID: String
+  let nonce: String
+
+  init(logicalID: String, nonce: String = UUID().uuidString) {
+    self.logicalID = logicalID
+    self.nonce = nonce
+    super.init()
+  }
+
+  required init?(coder: NSCoder) {
+    guard let logicalID = coder.decodeObject(forKey: "logicalID") as? String,
+          let nonce = coder.decodeObject(forKey: "nonce") as? String else { return nil }
+    self.logicalID = logicalID
+    self.nonce = nonce
+    super.init()
+  }
+
+  func encode(with coder: NSCoder) {
+    coder.encode(logicalID, forKey: "logicalID")
+    coder.encode(nonce, forKey: "nonce")
+  }
+
+  func copy(with _: NSZone? = nil) -> Any {
+    SyntheticSynchronizationAccountToken(logicalID: logicalID, nonce: nonce)
+  }
+
+  override func isEqual(_ object: Any?) -> Bool {
+    (object as? SyntheticSynchronizationAccountToken)?.logicalID == logicalID
+  }
+
+  override var hash: Int { logicalID.hashValue }
+}
