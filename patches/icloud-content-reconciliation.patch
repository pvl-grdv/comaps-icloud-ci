+bool BookmarkManager::IsCategoryFileSaving(std::string const & filePath) const
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  auto const groupId = GetCategoryByFileName(filePath);
+  if (groupId == kml::kInvalidMarkGroupId)
+    return false;
+  auto const & state = GetBmCategory(groupId)->m_fileSaveState;
+  return IsCategorySaving(groupId) || state->m_persistedRevision != state->m_localEditRevision;
+}
+
+bool BookmarkManager::DeleteCategoryAtFilePath(std::string const & filePath)
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  if (m_needTeardown || !m_loadBookmarksFinished || m_asyncLoadingInProgress || m_openedEditSessionsCount != 0)
+    return false;
+
+  auto const groupId = GetCategoryByFileName(filePath);
+  if (groupId != kml::kInvalidMarkGroupId)
+  {
+    if (IsCategoryFileSaving(filePath))
+      return false;
+    return GetEditSession().DeleteBmCategory(groupId, false);
+  }
+
+  if (!Platform::IsFileExistsByFullPath(filePath))
+    return true;
+  auto const trashedPath = GenerateValidAndUniqueTrashedFilePath(base::FileNameFromFullPath(filePath));
+  if (!base::MoveFileX(filePath, trashedPath))
+  {
+    LOG(LERROR, ("Failed to move", filePath, "into the trash at", trashedPath));
