+void FailIncomingAutosaveAndRestoreDisk(IncomingBookmarkFixture & fixture, std::string const & name)
+{
+  auto const path = std::filesystem::path(fixture.FilePath());
+  auto backup = path;
+  backup += ".before-failed-save";
+  std::filesystem::rename(path, backup);
+  std::filesystem::create_directory(path);
+  { FileWriter blocker((path / "blocker").string()); blocker.Write("block", 5); }
+  bool restored = false;
+  SCOPE_GUARD(restoreOriginal, [&]()
+  {
+    if (!restored)
+    {
+      std::filesystem::remove_all(path);
+      std::filesystem::rename(backup, path);
+    }
+  });
+  fixture.Manager().EnableTestMode(false);
+  std::future_status status;
+  {
+    base::ScopedLogAbortLevelChanger expectedFileError;
+    fixture.Manager().GetEditSession().SetCategoryName(fixture.GroupId(), name);
+    auto drained = std::make_shared<std::promise<void>>();
+    auto future = drained->get_future();
+    GetPlatform().RunTask(Platform::Thread::File, [drained]() { drained->set_value(); });
+    status = future.wait_for(std::chrono::seconds(10));
+  }
+  TEST(status == std::future_status::ready, ());
+  TEST(!fixture.Manager().IsCategorySaving(fixture.GroupId()), ());
+  std::filesystem::remove_all(path);
+  std::filesystem::rename(backup, path);
+  restored = true;
+  TEST_EQUAL(fixture.Names(), (std::vector<std::string>{name, "Original"}), ());
+}
+}
