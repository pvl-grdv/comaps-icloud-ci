+    let query = MetadataQueryMock([MetadataItemMock([
+      NSMetadataItemFSNameKey: "file.kml",
+      NSMetadataItemURLKey: URL(fileURLWithPath: "/cloud/.Trash/file.kml"),
+    ])])
