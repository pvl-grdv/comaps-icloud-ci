+import XCTest
+@testable import CoMaps__Debug_
+
+final class SynchronizationIncomingFileWriterTests: XCTestCase {
+  private func incomingFixture() throws -> (URL, URL, URL) {
+    let root = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString, isDirectory: true)
+    let local = root.appendingPathComponent("local", isDirectory: true)
+    let cloud = root.appendingPathComponent("cloud", isDirectory: true)
+    try FileManager.default.createDirectory(at: local, withIntermediateDirectories: true)
+    try FileManager.default.createDirectory(at: cloud, withIntermediateDirectories: true)
+    return (root, local, cloud)
+  }
+
+  private func incomingMetadata(_ url: URL) -> CloudMetadataItem {
+    CloudMetadataItem(fileName: url.lastPathComponent, fileUrl: url, lastModificationDate: 200, size: 0,
+                      isDownloaded: true, hasUnresolvedConflicts: false, downloadingError: nil, uploadingError: nil)
+  }
+
+  @MainActor
+  func testIncomingWriterStagesImmutableBytesBeforeTouchingLiveFile() async throws {
+    let (root, local, cloud) = try incomingFixture()
+    defer { try? FileManager.default.removeItem(at: root) }
+    let localURL = local.appendingPathComponent("Incoming.kml")
+    let cloudURL = cloud.appendingPathComponent("Incoming.kml")
+    let old = Data("local A".utf8), incoming = Data("cloud B".utf8)
+    try old.write(to: localURL)
+    try incoming.write(to: cloudURL)
+    let modified = Date(timeIntervalSince1970: 200)
+    try FileManager.default.setAttributes([.modificationDate: modified], ofItemAtPath: cloudURL.path)
+    let staged = expectation(description: "incoming snapshot delivered")
+    let settled = expectation(description: "incoming skip acknowledged")
+    let next = expectation(description: "next writer event completed")
+    let writer = SynchronizationFileWriter(localDirectoryUrl: local, cloudDirectoryUrl: cloud)
+    writer.processEvent(.updateLocalItem(with: incomingMetadata(cloudURL),
+                                         replacing: Fingerprint(hashing: old), preservingLocal: false)) { result in
+      switch result {
+      case .applyIncomingCategory(let snapshot):
+        defer { snapshot.finish(.skipped) }
+        XCTAssertTrue(Thread.isMainThread)
+        XCTAssertEqual(snapshot.targetURL, localURL)
+        XCTAssertNotEqual(snapshot.fileURL, localURL)
+        XCTAssertEqual(try? Data(contentsOf: localURL), old)
+        XCTAssertEqual(try? Data(contentsOf: snapshot.fileURL), incoming)
+        XCTAssertEqual(snapshot.fingerprint, Fingerprint(hashing: incoming))
+        let attributes = try? FileManager.default.attributesOfItem(atPath: snapshot.fileURL.path)
+        XCTAssertEqual(attributes?[.modificationDate] as? Date, modified)
+        let destinationAttributes = try? FileManager.default.attributesOfItem(atPath: local.path)
+        XCTAssertNotNil(attributes?[.systemNumber])
+        XCTAssertEqual(attributes?[.systemNumber] as? NSNumber, destinationAttributes?[.systemNumber] as? NSNumber)
+        try? Data("cloud C".utf8).write(to: cloudURL)
+        XCTAssertEqual(try? Data(contentsOf: snapshot.fileURL), incoming)
+        staged.fulfill()
+      case .skipped:
+        settled.fulfill()
+      default:
+        XCTFail("Unexpected result: \(result)")
+        settled.fulfill()
+      }
+    }
+    let probeURL = local.appendingPathComponent("QueueProbe.kml")
+    try Data("probe".utf8).write(to: probeURL)
+    writer.processEvent(.createCloudItem(with: try XCTUnwrap(LocalMetadataItem(fileUrl: probeURL)))) { result in
+      guard case .written = result else { XCTFail("Queued upload failed: \(result)"); next.fulfill(); return }
+      next.fulfill()
+    }
+    await fulfillment(of: [staged, settled, next], timeout: 5)
+    XCTAssertEqual(try Data(contentsOf: localURL), old)
+    withExtendedLifetime(writer) {}
+  }
+
+  @MainActor
+  func testIncomingWriterHoldsNextUploadUntilCoreAcknowledges() async throws {
+    let (root, local, cloud) = try incomingFixture()
+    defer { try? FileManager.default.removeItem(at: root) }
+    let localURL = local.appendingPathComponent("Incoming.kml")
+    let cloudURL = cloud.appendingPathComponent("Incoming.kml")
+    let old = Data("local A".utf8), incoming = Data("cloud B".utf8)
+    try old.write(to: localURL)
+    try incoming.write(to: cloudURL)
+    let staged = expectation(description: "incoming snapshot retained")
+    let settled = expectation(description: "incoming write acknowledged once")
+    let prematureUpload = expectation(description: "upload remains behind incoming core work")
+    prematureUpload.isInverted = true
+    let uploaded = expectation(description: "upload finished after core acknowledgement")
+    var pending: IncomingCategorySnapshot?
+    var acknowledged = false
+    var terminalCount = 0
+    let writer = SynchronizationFileWriter(localDirectoryUrl: local, cloudDirectoryUrl: cloud)
+    writer.processEvent(.updateLocalItem(with: incomingMetadata(cloudURL),
+                                         replacing: Fingerprint(hashing: old), preservingLocal: false)) { result in
+      if case .applyIncomingCategory(let snapshot) = result {
+        pending = snapshot
+        staged.fulfill()
+      } else {
+        terminalCount += 1
+        guard case .written(let fingerprint) = result else {
+          XCTFail("Unexpected incoming completion: \(result)")
+          settled.fulfill()
+          return
+        }
+        XCTAssertEqual(fingerprint, Fingerprint(hashing: incoming))
+        settled.fulfill()
+      }
+    }
+    await fulfillment(of: [staged], timeout: 5)
+    let snapshot = try XCTUnwrap(pending)
+    defer { snapshot.finish(.failed) }
+    let localItem = try XCTUnwrap(LocalMetadataItem(fileUrl: localURL))
+    writer.processEvent(.updateCloudItem(with: localItem, replacing: Fingerprint(hashing: incoming))) { result in
+      if !acknowledged { prematureUpload.fulfill() }
+      if case .failure(let error) = result { XCTFail("Upload failed: \(error)") }
+      uploaded.fulfill()
+    }
+    await fulfillment(of: [prematureUpload], timeout: 0.15)
+    XCTAssertEqual(try Data(contentsOf: cloudURL), incoming)
+    try FileManager.default.replaceItem(at: snapshot.targetURL, withItemAt: snapshot.fileURL,
+                                       backupItemName: nil, options: [.usingNewMetadataOnly], resultingItemURL: nil)
+    acknowledged = true
+    snapshot.finish(.applied)
+    snapshot.finish(.applied)
+    await fulfillment(of: [settled, uploaded], timeout: 5)
+    XCTAssertEqual(terminalCount, 1)
+    XCTAssertEqual(try Data(contentsOf: cloudURL), incoming)
+    pending = nil
+    withExtendedLifetime(writer) {}
+  }
+
+  @MainActor
+  func testUnavailableIncomingFileDoesNotBlockNextWriterEvent() async throws {
+    let (root, local, cloud) = try incomingFixture()
+    defer { try? FileManager.default.removeItem(at: root) }
+    let localURL = local.appendingPathComponent("Missing.kml")
+    let old = Data("local A".utf8)
+    try old.write(to: localURL)
+    let rejected = expectation(description: "unavailable source reported")
+    let next = expectation(description: "next writer event remains usable")
+    let writer = SynchronizationFileWriter(localDirectoryUrl: local, cloudDirectoryUrl: cloud)
+    let missing = incomingMetadata(cloud.appendingPathComponent("Missing.kml"))
+    writer.processEvent(.updateLocalItem(with: missing, replacing: Fingerprint(hashing: old), preservingLocal: false)) { result in
+      switch result {
+      case .failure, .skipped: break
+      default: XCTFail("Unavailable incoming content must not be installed: \(result)")
+      }
+      rejected.fulfill()
+    }
+    let probeURL = local.appendingPathComponent("QueueProbe.kml")
+    try Data("probe".utf8).write(to: probeURL)
+    writer.processEvent(.createCloudItem(with: try XCTUnwrap(LocalMetadataItem(fileUrl: probeURL)))) { result in
+      guard case .written = result else { XCTFail("Queued upload failed: \(result)"); next.fulfill(); return }
+      next.fulfill()
+    }
+    await fulfillment(of: [rejected, next], timeout: 5)
+    XCTAssertEqual(try Data(contentsOf: localURL), old)
+    withExtendedLifetime(writer) {}
+  }
+
+  func testIncomingSnapshotReleaseRemovesStagingDirectoryOnly() throws {
+    let (root, local, cloud) = try incomingFixture()
+    defer { try? FileManager.default.removeItem(at: root) }
+    let localURL = local.appendingPathComponent("Incoming.kml")
+    let cloudURL = cloud.appendingPathComponent("Incoming.kml")
+    try Data("local A".utf8).write(to: localURL)
+    try Data("cloud B".utf8).write(to: cloudURL)
+    var snapshot: IncomingCategorySnapshot? = try IncomingCategorySnapshot(
+      fileManager: .default, sourceURL: cloudURL, localDirectoryURL: local, targetURL: localURL)
+    let directory = try XCTUnwrap(snapshot?.fileURL.deletingLastPathComponent())
+    XCTAssertTrue(FileManager.default.fileExists(atPath: directory.path))
+    snapshot = nil
+    XCTAssertFalse(FileManager.default.fileExists(atPath: directory.path))
+    XCTAssertEqual(try Data(contentsOf: localURL), Data("local A".utf8))
+    XCTAssertEqual(try Data(contentsOf: cloudURL), Data("cloud B".utf8))
+  }
+}
