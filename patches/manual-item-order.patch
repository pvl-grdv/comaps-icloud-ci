+bool BookmarkManager::SetManualItemOrder(kml::MarkGroupId groupId,
+                                           std::vector<kml::MarkId> const & bookmarkIds,
+                                           std::vector<kml::TrackId> const & trackIds)
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  auto const category = m_categories.find(groupId);
+  if (category == m_categories.end())
+    return false;
+  auto const & currentBookmarks = category->second->GetUserMarks();
+  auto const & currentTracks = category->second->GetUserLines();
+  if (bookmarkIds.size() != currentBookmarks.size() || trackIds.size() != currentTracks.size() ||
+      kml::MarkIdSet(bookmarkIds.begin(), bookmarkIds.end()) != currentBookmarks ||
+      kml::TrackIdSet(trackIds.begin(), trackIds.end()) != currentTracks)
+    return false;
+
+  auto editSession = GetEditSession();
+  for (size_t i = 0; i < bookmarkIds.size(); ++i)
+  {
+    auto data = GetBookmark(bookmarkIds[i])->GetData();
+    auto const rank = std::to_string(i);
+    auto const property = data.m_properties.find(kItemOrderProperty);
+    if (property != data.m_properties.end() && property->second == rank)
+      continue;
+    data.m_properties[kItemOrderProperty] = rank;
+    editSession.GetBookmarkForEdit(bookmarkIds[i])->SetData(data);
+  }
+  for (size_t i = 0; i < trackIds.size(); ++i)
+  {
+    auto const & data = GetTrack(trackIds[i])->GetData();
+    auto const rank = std::to_string(i);
+    auto const property = data.m_properties.find(kItemOrderProperty);
+    if (property != data.m_properties.end() && property->second == rank)
+      continue;
+    editSession.GetTrackForEdit(trackIds[i])->SetCustomProperty(kItemOrderProperty, rank);
+  }
+  editSession.SetCategoryCustomProperty(groupId, kItemSortingProperty, ToString(SortingType::Manual));
+  return true;
 }
 
