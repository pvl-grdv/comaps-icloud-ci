+    originalBookmarks = category.m_bookmarks;
+    originalTracks = category.m_tracks;
+    filePath = manager.GetCategoryFileName(category.m_groupId);
+    std::reverse(category.m_bookmarks.begin(), category.m_bookmarks.end());
