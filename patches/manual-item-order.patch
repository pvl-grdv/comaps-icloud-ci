+                                    {category.m_bookmarks.front(), category.m_bookmarks.front()}, category.m_tracks), ());
+  TEST(!manager.SetManualItemOrder(category.m_groupId, {category.m_bookmarks.front()}, category.m_tracks), ());
+  TEST(!manager.SetManualItemOrder(category.m_groupId,
+                                    {category.m_bookmarks.front(), other.m_bookmarks.front()}, category.m_tracks), ());
+  TEST(!manager.SetManualItemOrder(category.m_groupId, category.m_bookmarks,
+                                    {category.m_tracks.front(), other.m_tracks.front()}), ());
