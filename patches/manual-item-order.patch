+void Track::SetCustomProperty(std::string const & key, std::string const & value)
+{
+  auto const it = m_data.m_properties.find(key);
+  if (it != m_data.m_properties.end() && it->second == value)
+    return;
+  m_isDirty = true;
+  m_data.m_properties[key] = value;
+}
+
+void Track::RemoveCustomProperty(std::string const & key)
+{
+  if (m_data.m_properties.erase(key) != 0)
+    m_isDirty = true;
+}
