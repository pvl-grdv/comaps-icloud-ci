+using ManualItemNames = std::pair<std::vector<std::string>, std::vector<std::string>>;
+
+ManualItemNames GetManualItemNames(BookmarkManager & manager, kml::MarkGroupId groupId)
+{
+  ManualItemNames result;
+  bool completed = false;
+  BookmarkManager::SortParams params;
+  params.m_groupId = groupId;
+  params.m_sortingType = BookmarkManager::SortingType::Manual;
+  params.m_onResults = [&](BookmarkManager::SortedBlocksCollection && blocks, BookmarkManager::SortParams::Status status)
+  {
+    TEST(status == BookmarkManager::SortParams::Status::Completed, ());
+    for (auto const & block : blocks)
+    {
+      for (auto const id : block.m_markIds)
+        result.first.push_back(kml::GetDefaultStr(manager.GetBookmark(id)->GetName()));
+      for (auto const id : block.m_trackIds)
+        result.second.push_back(manager.GetTrack(id)->GetName());
+    }
+    completed = true;
+  };
+  manager.GetSortedCategory(params);
+  TEST(completed, ());
+  return result;
+}
