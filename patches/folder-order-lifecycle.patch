+  func testBackgroundEndsEditBeforeLaterRemoteOrderWithoutRepublishing() throws {
+    coordinator.startOrForeground(); coordinator.beginEditing()
+    library.value.manualFileNames.reverse()
+    coordinator.background()
+    XCTAssertFalse(coordinator.isEditing)
+    XCTAssertEqual(editingEnds, 1)
+    XCTAssertEqual(store.writes.count, 1)
+    let remote = try payload(["B.kml", "C.kml", "A.kml"])
+    store.data = remote
+    coordinator.externalChange(.server)
+    coordinator.startOrForeground(); coordinator.background(); coordinator.endEditing()
+    XCTAssertEqual(library.value.manualFileNames, ["B.kml", "C.kml", "A.kml"])
+    XCTAssertEqual(store.data, remote)
+    XCTAssertEqual(store.writes.count, 1)
+    XCTAssertEqual(editingEnds, 1)
+  }
