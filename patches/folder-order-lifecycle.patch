+    coordinator.startOrForeground(); coordinator.beginEditing()
+    library.value.manualFileNames.reverse()
+    identity = FolderOrderTestIdentity("B")
+    store.data = try payload(["B.kml", "A.kml", "C.kml"])
+    coordinator.externalChange(.account)
+    XCTAssertFalse(coordinator.isEditing)
+    XCTAssertEqual(editingEnds, 1)
+    XCTAssertTrue(store.writes.isEmpty)
+    coordinator.endEditing()
+    XCTAssertEqual(editingEnds, 1)
+    coordinator.beginEditing()
+    library.value.manualFileNames = ["C.kml", "A.kml", "B.kml"]
+    coordinator.endEditing()
+    XCTAssertEqual(store.writes.count, 1)
+    XCTAssertEqual(editingEnds, 2)
+  }
