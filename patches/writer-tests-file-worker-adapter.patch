+private final class IncomingValidationThreadFileManager: FileManager {
+  private let targetPath: String
+  private let lock = NSLock()
+  private var checks = [Bool]()
+
+  init(targetPath: String) {
+    self.targetPath = URL(fileURLWithPath: targetPath).resolvingSymlinksInPath().path
+    super.init()
+  }
+
+  var targetChecksOnMainThread: [Bool] {
+    lock.lock()
+    defer { lock.unlock() }
+    return checks
+  }
+
+  override func fileExists(atPath path: String) -> Bool {
+    if URL(fileURLWithPath: path).resolvingSymlinksInPath().path == targetPath {
+      lock.lock()
+      checks.append(Thread.isMainThread)
+      lock.unlock()
+    }
+    return super.fileExists(atPath: path)
+  }
+}
