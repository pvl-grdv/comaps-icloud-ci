   /// A file evicted by iCloud, or replaced while it was being read, cannot be read at all. Nothing reports that
   /// it became readable, so giving up on it would leave it unsynchronized for the rest of the session.
   @MainActor
   func testFileThatCannotBeReadIsTriedAgain() async {
+    trace("body-enter testFileThatCannotBeReadIsTriedAgain")
     let item = item(named: "missing.kml")
 
     let firstReport = expectation(description: "The file may be worth reading again")
     provider.onContentsMayBeKnown = { firstReport.fulfill() }
     XCTAssertNil(provider.fingerprint(of: item))
+    traceHeartbeats("testFileThatCannotBeReadIsTriedAgain")
+    trace("await-begin \(#function)")
     await fulfillment(of: [firstReport], timeout: 5)
+    trace("await-return \(#function)")
 
     let secondReport = expectation(description: "The file may be worth reading again")
     provider.onContentsMayBeKnown = { secondReport.fulfill() }
     XCTAssertNil(provider.fingerprint(of: item), "The file still cannot be read")
+    trace("await-begin \(#function)")
     await fulfillment(of: [secondReport], timeout: 5)
+    trace("await-return \(#function)")
+  }
+
+  private func trace(_ phase: String) {
+    let identity = provider.map { String(describing: ObjectIdentifier($0)) } ?? "nil"
+    print("FPTEST uptime=\(ProcessInfo.processInfo.systemUptime) provider=\(identity) main=\(Thread.isMainThread) thread=\(Thread.current) qos=\(Thread.current.qualityOfService.rawValue) phase=\(phase)")
+  }
+
+  private func traceHeartbeats(_ test: String) {
+    let identity = provider.map { String(describing: ObjectIdentifier($0)) } ?? "nil"
+    let emit: (String) -> Void = { phase in
+      print("FPTEST uptime=\(ProcessInfo.processInfo.systemUptime) provider=\(identity) main=\(Thread.isMainThread) thread=\(Thread.current) qos=\(Thread.current.qualityOfService.rawValue) phase=\(phase) test=\(test)")
+    }
+    DispatchQueue.main.asyncAfter(deadline: .now() + 0.1) { emit("heartbeat-main") }
+    DispatchQueue.global(qos: .utility).async { emit("heartbeat-utility") }
+    DispatchQueue.global(qos: .userInitiated).async { emit("heartbeat-userInitiated") }
   }
 
