+bool SearchAPI::SearchSavedItems(search::SavedItemsSearchParams params)
+{
+  CHECK(static_cast<bool>(params.m_onResults), ());
+  SearchParams p;
+  p.m_query = std::move(params.m_query);
+  p.m_position = m_delegate.GetCurrentPosition();
+  SetViewportIfPossible(p);
+  p.m_maxNumResults = SearchParams::kDefaultNumBookmarksResults;
+  p.m_mode = Mode::Bookmarks;
+  p.m_suggestsEnabled = false;
+  p.m_needAddress = false;
+  p.m_bookmarksGroupId = KmlGroupIdToSearchGroupId(params.m_groupId);
+  p.m_savedItems = std::make_shared<std::vector<bookmarks::ItemDocument> const>(std::move(params.m_documents));
+  p.m_savedItemsDescriptions = params.m_indexDescriptions;
+  p.m_onResults = [](Results const &) {};
+  p.m_onSavedItemsResults =
+      [delegate = &m_delegate, onResults = std::move(params.m_onResults)](bookmarks::ItemResults results, bool cancelled)
+  {
+    auto const status = cancelled ? SavedItemsSearchParams::Status::Cancelled : SavedItemsSearchParams::Status::Completed;
+    delegate->RunUITask([onResults, results = std::move(results), status]() mutable
+    { onResults(std::move(results), status); });
+  };
+  return Search(std::move(p), true);
+}
