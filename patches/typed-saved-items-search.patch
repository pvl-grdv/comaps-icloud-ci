+
+void Processor::SearchSavedItems(SearchParams const & searchParams)
+{
+  bookmarks::ItemResults results;
+  try
+  {
+    bookmarks::SavedItemsIndex index(static_cast<base::Cancellable const &>(*this),
+                                    searchParams.m_savedItemsDescriptions);
+    if (index.Replace(*searchParams.m_savedItems))
+    {
+      bookmarks::Processor::Params params;
+      InitParams(params);
+      params.m_groupId = searchParams.m_bookmarksGroupId;
+      params.m_maxNumResults = searchParams.m_maxNumResults;
+      results = index.Search(params);
+    }
+    else
+    {
+      LOG(LWARNING, ("Invalid saved items search snapshot"));
+    }
+  }
+  catch (CancelException const &)
+  {
+    LOG(LDEBUG, ("Saved items search has been cancelled."));
+  }
+
+  searchParams.m_onSavedItemsResults(std::move(results), IsCancelled());
+  m_emitter.Finish(IsCancelled());
 }
 
