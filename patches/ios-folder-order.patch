diff --git a/iphone/Maps/Tests/Bookmarks/Categories/BookmarkFolderOrderTests.swift b/iphone/Maps/Tests/Bookmarks/Categories/BookmarkFolderOrderTests.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Tests/Bookmarks/Categories/BookmarkFolderOrderTests.swift
@@ -0,0 +1,97 @@
+import XCTest
+@testable import CoMaps__Debug_
+
+final class BookmarkFolderOrderTests: XCTestCase {
+  private var manager: BookmarksManager!
+  private var originalSortingType: BookmarkCategorySortingType!
+  private var categoryIds: [MWMMarkGroupID] = []
+
+  override func setUpWithError() throws {
+    try super.setUpWithError()
+    manager = BookmarksManager.shared()
+    manager.loadBookmarks()
+    let loaded = XCTNSPredicateExpectation(predicate: NSPredicate { [weak self] _, _ in
+      self?.manager?.areBookmarksLoaded() == true
+    }, object: nil)
+    guard XCTWaiter.wait(for: [loaded], timeout: 30) == .completed else {
+      throw NSError(domain: "BookmarkFolderOrderTests", code: 1,
+                    userInfo: [NSLocalizedDescriptionKey: "Bookmarks did not finish loading"])
+    }
+    originalSortingType = manager.categorySortingType()
+    let suffix = UUID().uuidString
+    categoryIds = [
+      manager.createCategory(withName: "Folder order A " + suffix),
+      manager.createCategory(withName: "Folder order B " + suffix)
+    ]
+  }
+
+  override func tearDown() {
+    categoryIds.forEach { manager.deleteCategory($0) }
+    if let originalSortingType {
+      _ = manager.setCategorySortingType(originalSortingType)
+    }
+    manager = nil
+    originalSortingType = nil
+    categoryIds = []
+    super.tearDown()
+  }
+
+  private var sortedIds: [MWMMarkGroupID] {
+    manager.sortedUserCategories().map(\.categoryId)
+  }
+
+  func testManualOrderMovesNewEmptyCategories() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let originalIds = sortedIds
+    let movingId = categoryIds[1]
+    XCTAssertTrue(manager.moveCategory(movingId, toPosition: 0))
+    XCTAssertEqual(manager.categorySortingType(), .manual)
+    XCTAssertEqual(sortedIds.first, movingId)
+    XCTAssertEqual(Set(sortedIds), Set(originalIds))
+    XCTAssertEqual(sortedIds.filter { $0 != movingId }, originalIds.filter { $0 != movingId })
+    XCTAssertTrue(manager.moveCategory(movingId, toPosition: originalIds.count - 1))
+    XCTAssertEqual(sortedIds.last, movingId)
+  }
+
+  func testAutomaticModeRejectsMoves() {
+    XCTAssertTrue(manager.setCategorySortingType(.byName))
+    let originalIds = sortedIds
+    XCTAssertFalse(manager.moveCategory(categoryIds[1], toPosition: 0))
+    XCTAssertEqual(manager.categorySortingType(), .byName)
+    XCTAssertEqual(sortedIds, originalIds)
+  }
+
+  func testInvalidDestinationsLeaveOrderUntouched() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let originalIds = sortedIds
+    XCTAssertFalse(manager.moveCategory(categoryIds[0], toPosition: -1))
+    XCTAssertFalse(manager.moveCategory(categoryIds[0], toPosition: originalIds.count))
+    XCTAssertEqual(sortedIds, originalIds)
+  }
+
+  func testUnknownCategoryLeavesOrderUntouched() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let originalIds = sortedIds
+    XCTAssertFalse(manager.moveCategory(MWMMarkGroupID.max, toPosition: 0))
+    XCTAssertEqual(sortedIds, originalIds)
+  }
+
+  func testNewFolderIsAppendedToExistingManualOrder() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    XCTAssertTrue(manager.moveCategory(categoryIds[1], toPosition: 0))
+    let originalIds = sortedIds
+    let newId = manager.createCategory(withName: "Folder order new " + UUID().uuidString)
+    categoryIds.append(newId)
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    XCTAssertEqual(Array(sortedIds.prefix(originalIds.count)), originalIds)
+    XCTAssertEqual(sortedIds.last, newId)
+  }
+
+  func testAutomaticSortRestoresCategoryNameOrder() {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    XCTAssertTrue(manager.moveCategory(categoryIds[1], toPosition: 0))
+    XCTAssertTrue(manager.setCategorySortingType(.byName))
+    let ids = sortedIds.filter { categoryIds.contains($0) }
+    XCTAssertEqual(ids, [categoryIds[0], categoryIds[1]])
+  }
+}
