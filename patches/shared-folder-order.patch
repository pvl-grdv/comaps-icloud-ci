+std::vector<std::string> const & BookmarkManager::GetManualCategoryOrder() const
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  return m_metadata.m_categoryOrder;
+}
+
+bool BookmarkManager::ApplyCategoryOrder(CategorySortType sortType, std::vector<std::string> const & fileNames)
+{
+  CHECK_THREAD_CHECKER(m_threadChecker, ());
+  std::vector<std::string> order;
+  std::set<std::string> included;
+  for (auto const & fileName : fileNames)
+  {
+    if (!fileName.empty() && fileName == base::FileNameFromFullPath(fileName) &&
+        GetCategoryByFileName(fileName) != kml::kInvalidMarkGroupId && included.insert(fileName).second)
+      order.push_back(fileName);
+  }
+  for (auto const groupId : GetSortedBmGroupIdList())
+  {
+    auto const fileName = base::FileNameFromFullPath(GetCategoryFileName(groupId));
+    if (!fileName.empty() && included.insert(fileName).second)
+      order.push_back(fileName);
+  }
+  sortType = NormalizeCategorySortType(sortType);
+  if (m_metadata.m_categorySortType == sortType && m_metadata.m_categoryOrder == order)
+    return false;
+  m_metadata.m_categorySortType = sortType;
+  m_metadata.m_categoryOrder = std::move(order);
+  SaveMetadata();
+  NotifyBookmarksChanged();
+  NotifyCategoriesChanged();
+  return true;
+}
