+  func testOpaqueIdentityCanonicalizesUnicodeAndRejectsPaths() throws {
+    XCTAssertEqual(try SharedFolderOrder.token(forFileName: "Café.kml"),
+                   try SharedFolderOrder.token(forFileName: "Cafe\u{301}.kml"))
+    XCTAssertNil(try? SharedFolderOrder.token(forFileName: "../A.kml"))
+    XCTAssertNil(try? SharedFolderOrder.token(forFileName: "A.json"))
+    let encoded = try payload(["Private folder.kml"])
+    XCTAssertFalse(String(decoding: encoded, as: UTF8.self).contains("Private folder"))
+  }
