+
+  func testMalformedFutureDuplicateAndOversizedPayloadsAreIgnored() throws {
+    let token = try SharedFolderOrder.token(forFileName: "A.kml")
+    let invalidRecords = [SharedFolderOrderRecord(version: 99, mode: .manual, tokens: [token]),
+                          SharedFolderOrderRecord(version: 1, mode: .manual, tokens: [token, token]),
+                          SharedFolderOrderRecord(version: 1, mode: .manual, tokens: ["invalid"])]
+    var invalid = try invalidRecords.map { try PropertyListEncoder().encode($0) }
+    invalid.append(Data("malformed".utf8))
+    invalid.append(Data(repeating: 0, count: SharedFolderOrder.maximumRecordBytes + 1))
+    for data in invalid {
+      store.data = data; coordinator.externalChange(.server)
+      XCTAssertEqual(library.applications, 0); XCTAssertTrue(store.writes.isEmpty)
+    }
+  }
