diff --git a/iphone/Maps/Core/iCloud/BookmarkFolderOrderSynchronization.swift b/iphone/Maps/Core/iCloud/BookmarkFolderOrderSynchronization.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Core/iCloud/BookmarkFolderOrderSynchronization.swift
@@ -0,0 +1,121 @@
+import Foundation
+import UIKit
+
+extension Notification.Name {
+  static let bookmarkFolderOrderDidApply = Notification.Name("comaps.folder-order.did-apply")
+}
+
+private final class BookmarksFolderOrderLibrary: NSObject, FolderOrderLibrary, BookmarksObserver {
+  let manager: BookmarksManager
+  var didChange: (() -> Void)?
+
+  init(manager: BookmarksManager = .shared()) {
+    self.manager = manager
+    super.init()
+  }
+
+  func snapshot() -> FolderOrderLibrarySnapshot {
+    FolderOrderLibrarySnapshot(isLoaded: manager.areBookmarksLoaded(),
+                               mode: SharedFolderSort(manager.categorySortingType()),
+                               manualFileNames: manager.manualCategoryFileNames(),
+                               fileNames: manager.categoryFileNames())
+  }
+
+  func apply(mode: SharedFolderSort, manualFileNames: [String]) -> Bool {
+    manager.applyCategorySortingType(mode.categorySortingType, manualFileNames: manualFileNames)
+  }
+
+  func onBookmarksLoadFinished() { didChange?() }
+  func onBookmarksFileLoadSuccess() { didChange?() }
+  func onBookmarksCategoryDeleted(_ groupId: MWMMarkGroupID) { didChange?() }
+}
+
+private extension SharedFolderSort {
+  init(_ type: BookmarkCategorySortingType) {
+    switch type {
+    case .byLastModified: self = .date
+    case .byName: self = .name
+    case .manual: self = .manual
+    @unknown default: self = .date
+    }
+  }
+
+  var categorySortingType: BookmarkCategorySortingType {
+    switch self {
+    case .date: return .byLastModified
+    case .name: return .byName
+    case .manual: return .manual
+    }
+  }
+}
+
+final class BookmarkFolderOrderSynchronization {
+  static let shared = BookmarkFolderOrderSynchronization()
+
+  private let library = BookmarksFolderOrderLibrary()
+  private var observers: [NSObjectProtocol] = []
+  private var isStarted = false
+  private lazy var coordinator = FolderOrderCoordinator(
+    library: library,
+    storeFactory: { UbiquitousFolderOrderStore(store: .default) },
+    isEnabled: { Settings.shouldSync },
+    accountIdentity: { FileManager.default.ubiquityIdentityToken },
+    didApply: { NotificationCenter.default.post(name: .bookmarkFolderOrderDidApply, object: nil) },
+    onError: { LOG(.error, $0.localizedDescription) })
+
+  private init() {}
+
+  func start() {
+    guard !isStarted else { return }
+    isStarted = true
+    library.didChange = { [weak self] in self?.coordinator.bookmarksChanged() }
+    library.manager.add(library)
+    observe(UIApplication.didBecomeActiveNotification) { $0.coordinator.startOrForeground() }
+    observe(UIApplication.didEnterBackgroundNotification) { $0.coordinator.background() }
+    observe(UIApplication.protectedDataDidBecomeAvailableNotification) { $0.coordinator.startOrForeground() }
+    observe(NSNotification.iCloudSynchronizationDidChangeEnabledState) { $0.coordinator.settingsChanged() }
+    observe(.NSUbiquityIdentityDidChange) { $0.coordinator.externalChange(.account) }
+    observeCloud()
+    coordinator.startOrForeground()
+  }
+
+  func beginEditing() {
+    if isStarted { coordinator.beginEditing() }
+  }
+
+  func endEditing() {
+    if isStarted { coordinator.endEditing() }
+  }
+
+  func localOrderChanged() {
+    if isStarted { coordinator.localOrderChanged() }
+  }
+
+  private func observeCloud() {
+    observers.append(NotificationCenter.default.addObserver(
+      forName: NSUbiquitousKeyValueStore.didChangeExternallyNotification, object: nil, queue: .main
+    ) { [weak self] notification in
+      guard let self,
+            let reason = notification.userInfo?[NSUbiquitousKeyValueStoreChangeReasonKey] as? Int else { return }
+      switch reason {
+      case NSUbiquitousKeyValueStoreServerChange:
+        self.coordinator.externalChange(.server)
+      case NSUbiquitousKeyValueStoreInitialSyncChange:
+        self.coordinator.externalChange(.initial)
+      case NSUbiquitousKeyValueStoreQuotaViolationChange:
+        self.coordinator.externalChange(.quota)
+      case NSUbiquitousKeyValueStoreAccountChange:
+        self.coordinator.externalChange(.account)
+      default: break
+      }
+    })
+  }
+
+  private func observe(_ name: Notification.Name,
+                       handler: @escaping (BookmarkFolderOrderSynchronization) -> Void) {
+    observers.append(NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main) { [weak self] _ in
+      guard let self else { return }
+      handler(self)
+    })
+  }
+}
diff --git a/iphone/Maps/Core/iCloud/FolderOrderCoordinator.swift b/iphone/Maps/Core/iCloud/FolderOrderCoordinator.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Core/iCloud/FolderOrderCoordinator.swift
@@ -0,0 +1,143 @@
+import Foundation
+
+struct FolderOrderLibrarySnapshot: Equatable {
+  var isLoaded: Bool
+  var mode: SharedFolderSort
+  var manualFileNames: [String]
+  var fileNames: [String]
+}
+
+protocol FolderOrderLibrary: AnyObject {
+  func snapshot() -> FolderOrderLibrarySnapshot
+  @discardableResult func apply(mode: SharedFolderSort, manualFileNames: [String]) -> Bool
+}
+
+enum FolderOrderExternalChange {
+  case server, initial, quota, account
+}
+
+final class FolderOrderCoordinator {
+  private let library: FolderOrderLibrary
+  private let storeFactory: () -> SharedFolderOrderStore
+  private let isEnabled: () -> Bool
+  private let accountIdentity: () -> NSObjectProtocol?
+  private let didApply: () -> Void
+  private let onError: (Error) -> Void
+  private var store: SharedFolderOrderStore?
+  private(set) var isEditing = false
+  private var editingAccountIdentity: NSObjectProtocol?
+
+  init(library: FolderOrderLibrary, storeFactory: @escaping () -> SharedFolderOrderStore,
+       isEnabled: @escaping () -> Bool, accountIdentity: @escaping () -> NSObjectProtocol?,
+       didApply: @escaping () -> Void = {}, onError: @escaping (Error) -> Void = { _ in }) {
+    self.library = library
+    self.storeFactory = storeFactory
+    self.isEnabled = isEnabled
+    self.accountIdentity = accountIdentity
+    self.didApply = didApply
+    self.onError = onError
+  }
+
+  func startOrForeground() {
+    guard let store = availableStore() else { return }
+    store.synchronize()
+    if !isEditing { applyRemote() }
+  }
+
+  func settingsChanged() { startOrForeground() }
+
+  func bookmarksChanged() {
+    if !isEditing { applyRemote() }
+  }
+
+  func beginEditing() {
+    isEditing = true
+    editingAccountIdentity = accountIdentity()
+  }
+
+  func endEditing() {
+    guard isEditing else { return }
+    guard editingAccountMatchesCurrent() else {
+      cancelEditing()
+      return
+    }
+    isEditing = false
+    editingAccountIdentity = nil
+    localOrderChanged()
+  }
+
+  func background() {
+    guard isEditing else { return }
+    guard editingAccountMatchesCurrent() else {
+      cancelEditing()
+      return
+    }
+    localOrderChanged()
+  }
+
+  private func editingAccountMatchesCurrent() -> Bool {
+    guard let original = editingAccountIdentity, let current = accountIdentity() else { return false }
+    return original.isEqual(current)
+  }
+
+  private func cancelEditing() {
+    isEditing = false
+    editingAccountIdentity = nil
+    applyRemote()
+  }
+
+  func localOrderChanged() {
+    let snapshot = library.snapshot()
+    guard snapshot.isLoaded, let store = availableStore() else { return }
+    do {
+      let tokens = try snapshot.manualFileNames.map(SharedFolderOrder.token(forFileName:))
+      guard Set(tokens).count == tokens.count else { throw SharedFolderOrderError.invalidIdentity }
+      let previous = SharedFolderOrder.decode(store.data)
+      let record = SharedFolderOrderRecord(version: 1, mode: snapshot.mode,
+        tokens: SharedFolderOrder.replacingVisibleOrder(tokens, in: previous))
+      guard record != previous else { return }
+      store.set(try SharedFolderOrder.encode(record))
+      store.synchronize()
+    } catch {
+      onError(error)
+    }
+  }
+
+  func externalChange(_ reason: FolderOrderExternalChange) {
+    guard isEnabled() else { return }
+    if reason == .account, isEditing, !editingAccountMatchesCurrent() {
+      cancelEditing()
+      return
+    }
+    guard accountIdentity() != nil else { return }
+    if reason == .quota {
+      onError(SharedFolderOrderError.quotaExceeded)
+      return
+    }
+    if !isEditing { applyRemote() }
+  }
+
+  private func availableStore() -> SharedFolderOrderStore? {
+    guard isEnabled(), accountIdentity() != nil else { return nil }
+    if store == nil { store = storeFactory() }
+    return store
+  }
+
+  private func applyRemote() {
+    guard let store = availableStore(), let record = SharedFolderOrder.decode(store.data) else { return }
+    let snapshot = library.snapshot()
+    guard snapshot.isLoaded else { return }
+    do {
+      let pairs = try snapshot.fileNames.map { (try SharedFolderOrder.token(forFileName: $0), $0) }
+      guard Set(pairs.map(\.0)).count == pairs.count else { throw SharedFolderOrderError.invalidIdentity }
+      let namesByToken = Dictionary(uniqueKeysWithValues: pairs)
+      let order = SharedFolderOrder.projectedOrder(record, availableTokens: pairs.map(\.0))
+      let names = order.compactMap { namesByToken[$0] }
+      if snapshot.mode != record.mode || snapshot.manualFileNames != names {
+        if library.apply(mode: record.mode, manualFileNames: names) { didApply() }
+      }
+    } catch {
+      onError(error)
+    }
+  }
+}
diff --git a/iphone/Maps/Core/iCloud/SharedFolderOrder.swift b/iphone/Maps/Core/iCloud/SharedFolderOrder.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Core/iCloud/SharedFolderOrder.swift
@@ -0,0 +1,80 @@
+import Foundation
+import CryptoKit
+
+enum SharedFolderSort: Int, Codable {
+  case date, name, manual
+}
+
+enum SharedFolderOrderError: Error {
+  case invalidIdentity, invalidRecord, recordTooLarge, quotaExceeded
+}
+
+struct SharedFolderOrderRecord: Codable, Equatable {
+  let version: Int
+  let mode: SharedFolderSort
+  let tokens: [String]
+}
+
+protocol SharedFolderOrderStore: AnyObject {
+  var data: Data? { get }
+  func set(_ data: Data)
+  func synchronize()
+}
+
+final class UbiquitousFolderOrderStore: SharedFolderOrderStore {
+  private let store: NSUbiquitousKeyValueStore
+  private let key = "comaps.folder-order.preference.v1"
+
+  init(store: NSUbiquitousKeyValueStore) { self.store = store }
+  var data: Data? { store.data(forKey: key) }
+  func set(_ data: Data) { store.set(data, forKey: key) }
+  func synchronize() { store.synchronize() }
+}
+
+enum SharedFolderOrder {
+  static let maximumRecordBytes = 65_536
+
+  static func token(forFileName fileName: String) throws -> String {
+    guard !fileName.isEmpty,
+          fileName == (fileName as NSString).lastPathComponent,
+          !fileName.contains("\0"),
+          fileName.lowercased().hasSuffix(".kml") else { throw SharedFolderOrderError.invalidIdentity }
+    let canonical = fileName.precomposedStringWithCanonicalMapping
+    return SHA256.hash(data: Data(("comaps.folder-identity.v1\0" + canonical).utf8))
+      .map { String(format: "%02x", $0) }.joined()
+  }
+
+  static func encode(_ record: SharedFolderOrderRecord) throws -> Data {
+    guard record.version == 1, Set(record.tokens).count == record.tokens.count,
+          record.tokens.allSatisfy({ token in
+            token.utf8.count == 64 && token.utf8.allSatisfy { (48...57).contains($0) || (97...102).contains($0) }
+          }) else { throw SharedFolderOrderError.invalidRecord }
+    let encoder = PropertyListEncoder()
+    encoder.outputFormat = .binary
+    let data = try encoder.encode(record)
+    guard data.count <= maximumRecordBytes else { throw SharedFolderOrderError.recordTooLarge }
+    return data
+  }
+
+  static func decode(_ data: Data?) -> SharedFolderOrderRecord? {
+    guard let data, data.count <= maximumRecordBytes,
+          let record = try? PropertyListDecoder().decode(SharedFolderOrderRecord.self, from: data),
+          (try? encode(record)) != nil else { return nil }
+    return record
+  }
+
+  static func projectedOrder(_ record: SharedFolderOrderRecord, availableTokens: [String]) -> [String] {
+    let available = Set(availableTokens)
+    let ordered = record.tokens.filter { available.contains($0) }
+    let known = Set(ordered)
+    return ordered + availableTokens.filter { !known.contains($0) }.sorted()
+  }
+
+  static func replacingVisibleOrder(_ visibleOrder: [String], in previous: SharedFolderOrderRecord?) -> [String] {
+    let visible = Set(visibleOrder)
+    var iterator = visibleOrder.makeIterator()
+    var order = (previous?.tokens ?? []).map { visible.contains($0) ? iterator.next()! : $0 }
+    while let token = iterator.next() { order.append(token) }
+    return order
+  }
+}
