+  func testDisabledRemoteEventsWaitForExplicitReenable() throws {
+    coordinator.startOrForeground(); enabled = false; coordinator.settingsChanged()
+    store.data = try payload(["B.kml", "C.kml", "A.kml"])
+    coordinator.externalChange(.server)
+    XCTAssertEqual(library.applications, 0)
