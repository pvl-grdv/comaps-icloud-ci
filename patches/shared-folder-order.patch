+UNIT_CLASS_TEST(Runner, Bookmarks_ApplySharedFolderOrderPreservesSavedManualOrderAndKML)
+{
+  BookmarkManager bmManager(BM_CALLBACKS);
+  bmManager.EnableTestMode(true);
+  auto const first = bmManager.CreateBookmarkCategory("Shared order A", false);
+  auto const second = bmManager.CreateBookmarkCategory("Shared order B", false);
+  TEST(bmManager.SaveBookmarkCategory(first), ());
+  TEST(bmManager.SaveBookmarkCategory(second), ());
+  auto const firstFile = bmManager.GetCategoryFileName(first);
+  auto const secondFile = bmManager.GetCategoryFileName(second);
+  SCOPE_GUARD(filesDeleter, [&]()
+  {
+    (void)base::DeleteFileX(firstFile);
+    (void)base::DeleteFileX(secondFile);
+  });
+  std::filesystem::last_write_time(firstFile,
+                                  std::filesystem::file_time_type::clock::now() - std::chrono::hours(24));
+  std::filesystem::last_write_time(secondFile,
+                                  std::filesystem::file_time_type::clock::now() - std::chrono::hours(24));
+  auto const firstModified = Platform::GetFileModificationTime(firstFile);
+  auto const secondModified = Platform::GetFileModificationTime(secondFile);
+  std::string firstContents, secondContents;
+  FileReader(firstFile).ReadAsString(firstContents);
+  FileReader(secondFile).ReadAsString(secondContents);
+  std::vector<std::string> const manualOrder = {base::FileNameFromFullPath(secondFile),
+                                               base::FileNameFromFullPath(firstFile)};
+  TEST(bmManager.ApplyCategoryOrder(BookmarkManager::CategorySortType::ByName, manualOrder), ());
+  TEST_EQUAL(bmManager.GetManualCategoryOrder(), manualOrder, ());
+  kml::GroupIdCollection const nameIds = {first, second};
+  TEST_EQUAL(bmManager.GetSortedBmGroupIdList(), nameIds, ());
+  TEST(!bmManager.ApplyCategoryOrder(BookmarkManager::CategorySortType::ByName, manualOrder), ());
+  TEST(bmManager.ApplyCategoryOrder(BookmarkManager::CategorySortType::ByLastModified, manualOrder), ());
+  TEST_EQUAL(bmManager.GetManualCategoryOrder(), manualOrder, ());
+  TEST(bmManager.ApplyCategoryOrder(BookmarkManager::CategorySortType::Manual, manualOrder), ());
+  kml::GroupIdCollection const manualIds = {second, first};
+  TEST_EQUAL(bmManager.GetSortedBmGroupIdList(), manualIds, ());
+  TEST_EQUAL(bmManager.GetCategoryData(first).m_id, first, ());
+  TEST_EQUAL(bmManager.GetCategoryData(second).m_id, second, ());
+  TEST_EQUAL(Platform::GetFileModificationTime(firstFile), firstModified, ());
+  TEST_EQUAL(Platform::GetFileModificationTime(secondFile), secondModified, ());
+  std::string firstAfter, secondAfter;
+  FileReader(firstFile).ReadAsString(firstAfter);
+  FileReader(secondFile).ReadAsString(secondAfter);
+  TEST_EQUAL(firstAfter, firstContents, ());
+  TEST_EQUAL(secondAfter, secondContents, ());
+  std::string metadata;
+  FileReader(base::JoinPath(GetPlatform().WritableDir(), "bm.json")).ReadAsString(metadata);
+  auto const orderPosition = metadata.find("categoryOrder");
+  TEST_NOT_EQUAL(orderPosition, std::string::npos, ());
+  auto const firstPosition = metadata.find(manualOrder[0], orderPosition);
+  auto const secondPosition = metadata.find(manualOrder[1], orderPosition);
+  TEST_NOT_EQUAL(firstPosition, std::string::npos, ());
+  TEST_NOT_EQUAL(secondPosition, std::string::npos, ());
+  TEST_LESS(firstPosition, secondPosition, ());
+}
