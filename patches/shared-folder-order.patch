+import Foundation
+import XCTest
+@testable import CoMaps__Debug_
+
+private final class FolderOrderTestIdentity: NSObject {
+  let value: String
+  init(_ value: String) { self.value = value }
+  override func isEqual(_ object: Any?) -> Bool { (object as? FolderOrderTestIdentity)?.value == value }
+  override var hash: Int { value.hashValue }
+}
+
+private final class FolderOrderTestStore: SharedFolderOrderStore {
+  var data: Data?
+  var writes: [Data] = []
+  var synchronizationRequests = 0
+  func set(_ data: Data) { self.data = data; writes.append(data) }
+  func synchronize() { synchronizationRequests += 1 }
+}
+
+private final class FolderOrderTestLibrary: FolderOrderLibrary {
+  var value = FolderOrderLibrarySnapshot(isLoaded: true, mode: .manual,
+                                       manualFileNames: ["A.kml", "B.kml", "C.kml"],
+                                       fileNames: ["A.kml", "B.kml", "C.kml"])
+  var applications = 0
+  func snapshot() -> FolderOrderLibrarySnapshot { value }
+  func apply(mode: SharedFolderSort, manualFileNames: [String]) -> Bool {
+    value.mode = mode
+    value.manualFileNames = manualFileNames
+    applications += 1
+    return true
+  }
+}
+
+final class SharedFolderOrderCoordinatorTests: XCTestCase {
+  private var library: FolderOrderTestLibrary!
+  private var store: FolderOrderTestStore!
+  private var enabled = true
+  private var signedIn = true
+  private var identity = FolderOrderTestIdentity("A")
+  private var storeCreations = 0
+  private var applies = 0
+  private var errors = 0
+  private var coordinator: FolderOrderCoordinator!
+
+  override func setUp() {
+    super.setUp()
+    library = FolderOrderTestLibrary(); store = FolderOrderTestStore()
+    identity = FolderOrderTestIdentity("A")
+    enabled = true; signedIn = true; storeCreations = 0; applies = 0; errors = 0
+    coordinator = makeCoordinator()
+  }
+
+  private func makeCoordinator() -> FolderOrderCoordinator {
+    FolderOrderCoordinator(library: library,
+                           storeFactory: { [unowned self] in self.storeCreations += 1; return self.store },
+                           isEnabled: { [unowned self] in self.enabled },
+                           accountIdentity: { [unowned self] in self.signedIn ? self.identity : nil },
+                           didApply: { [unowned self] in self.applies += 1 },
+                           onError: { [unowned self] _ in self.errors += 1 })
+  }
+
+  private func payload(_ names: [String], mode: SharedFolderSort = .manual) throws -> Data {
+    try SharedFolderOrder.encode(SharedFolderOrderRecord(version: 1, mode: mode,
+      tokens: names.map(SharedFolderOrder.token(forFileName:))))
+  }
+
+  func testDisabledDoesNotCreateCloudStoreOrApplyChanges() throws {
+    enabled = false
+    store.data = try payload(["C.kml", "B.kml", "A.kml"])
+    coordinator.startOrForeground(); coordinator.localOrderChanged(); coordinator.bookmarksChanged()
+    coordinator.externalChange(.server)
+    XCTAssertEqual(storeCreations, 0)
+    XCTAssertEqual(library.applications, 0); XCTAssertTrue(store.writes.isEmpty)
+  }
+
+  func testMissingAccountKeepsLocalOrderWithoutWritingCloud() throws {
+    signedIn = false
+    store.data = try payload(["C.kml", "B.kml", "A.kml"])
+    coordinator.startOrForeground(); coordinator.localOrderChanged(); coordinator.externalChange(.server)
+    XCTAssertEqual(storeCreations, 0); XCTAssertTrue(store.writes.isEmpty)
+    XCTAssertEqual(library.value.manualFileNames, ["A.kml", "B.kml", "C.kml"])
+  }
+
+  func testInitialEmptyCloudDoesNotPublishExistingLocalOrder() {
+    coordinator.startOrForeground()
