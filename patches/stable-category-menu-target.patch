diff --git a/iphone/Maps/Tests/Bookmarks/Categories/BookmarkFolderOrderTests.swift b/iphone/Maps/Tests/Bookmarks/Categories/BookmarkFolderOrderTests.swift
--- a/iphone/Maps/Tests/Bookmarks/Categories/BookmarkFolderOrderTests.swift
+++ b/iphone/Maps/Tests/Bookmarks/Categories/BookmarkFolderOrderTests.swift
@@ -105,4 +105,34 @@
     XCTAssertFalse(controller.isEditing)
   }
 
+  @MainActor
+  func testMenuTargetRemainsSameCategoryAfterRemoteOrderChanges() async throws {
+    XCTAssertTrue(manager.setCategorySortingType(.manual))
+    let model = BMCDefaultViewModel()
+    let targetId = categoryIds[1]
+    let oldIndex = try XCTUnwrap(model.categoryIndex(forId: targetId))
+    var remoteOrder = manager.manualCategoryFileNames()
+    XCTAssertGreaterThan(remoteOrder.count, 1)
+    let first = remoteOrder.removeFirst()
+    remoteOrder.append(first)
+    XCTAssertTrue(manager.applyCategorySortingType(.manual, manualFileNames: remoteOrder))
+    model.reloadData()
+    let currentIndex = try XCTUnwrap(model.categoryIndex(forId: targetId))
+    XCTAssertNotEqual(currentIndex, oldIndex)
+    model.deleteCategory(at: currentIndex)
+    XCTAssertFalse(manager.hasCategory(targetId))
+    XCTAssertTrue(manager.hasCategory(categoryIds[0]))
+  }
+
+  @MainActor
+  func testRemovedMenuTargetNoLongerResolvesToAnotherCategory() async throws {
+    let model = BMCDefaultViewModel()
+    let targetId = categoryIds[1]
+    XCTAssertNotNil(model.categoryIndex(forId: targetId))
+    XCTAssertTrue(manager.deleteCategory(targetId))
+    model.reloadData()
+    XCTAssertNil(model.categoryIndex(forId: targetId))
+    XCTAssertTrue(manager.hasCategory(categoryIds[0]))
+  }
+
 }
