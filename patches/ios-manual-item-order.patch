+import XCTest
+@testable import CoMaps__Debug_
+
+final class BookmarkItemOrderModelTests: XCTestCase {
+  func testMovingBookmarkLeavesTrackSequenceUnchanged() throws {
+    var order = try XCTUnwrap(BookmarkItemOrder(bookmarkIds: [1, 2, 3], trackIds: [7, 8]))
+    XCTAssertTrue(order.move(in: .bookmarks, from: 0, to: 2))
+    XCTAssertEqual(order.bookmarkIds, [2, 3, 1])
+    XCTAssertEqual(order.trackIds, [7, 8])
+  }
+
+  func testMovingTrackLeavesBookmarkSequenceUnchanged() throws {
+    var order = try XCTUnwrap(BookmarkItemOrder(bookmarkIds: [1, 2], trackIds: [7, 8, 9]))
+    XCTAssertTrue(order.move(in: .tracks, from: 2, to: 0))
+    XCTAssertEqual(order.bookmarkIds, [1, 2])
+    XCTAssertEqual(order.trackIds, [9, 7, 8])
+  }
+
+  func testEqualNumericIdsInDifferentSectionsRemainDistinct() throws {
+    var order = try XCTUnwrap(BookmarkItemOrder(bookmarkIds: [1, 2], trackIds: [1, 2]))
+    XCTAssertTrue(order.move(in: .tracks, from: 0, to: 1))
+    XCTAssertEqual(order.bookmarkIds, [1, 2])
+    XCTAssertEqual(order.trackIds, [2, 1])
+  }
+
+  func testInvalidMoveDoesNotChangeEitherSequence() throws {
+    var order = try XCTUnwrap(BookmarkItemOrder(bookmarkIds: [1, 2], trackIds: [7]))
+    let original = order
+    XCTAssertFalse(order.move(in: .bookmarks, from: -1, to: 0))
+    XCTAssertFalse(order.move(in: .tracks, from: 0, to: 1))
+    XCTAssertEqual(order, original)
+  }
+
+  func testDuplicateIdsWithinEitherSectionAreRejected() {
+    XCTAssertNil(BookmarkItemOrder(bookmarkIds: [1, 1], trackIds: []))
+    XCTAssertNil(BookmarkItemOrder(bookmarkIds: [], trackIds: [2, 2]))
+  }
+
+  func testMovingToSamePositionKeepsOrder() throws {
+    var order = try XCTUnwrap(BookmarkItemOrder(bookmarkIds: [1, 2], trackIds: []))
+    let original = order
+    XCTAssertTrue(order.move(in: .bookmarks, from: 1, to: 1))
+    XCTAssertEqual(order, original)
+  }
+}
+
+final class BookmarkItemOrderBridgeTests: XCTestCase, BookmarksObserver {
+  private var manager: BookmarksManager { BookmarksManager.shared() }
+  private var pending: XCTestExpectation?
+  private var category: BookmarkGroup?
+  private var fixtureFile: URL?
+
+  override func setUp() async throws {
+    try await super.setUp()
+    try await prepareFixture()
+  }
+
+  override func tearDown() async throws {
+    await cleanupFixture()
+    try await super.tearDown()
+  }
+
+  @MainActor
+  private func prepareFixture() async throws {
+    manager.add(self)
+    if !manager.areBookmarksLoaded() {
+      pending = expectation(description: "Load bookmarks")
+      manager.loadBookmarks()
+      await fulfillment(of: [pending!], timeout: 30)
+      pending = nil
+    }
+    let title = "Manual fixture \(UUID().uuidString)"
+    let file = FileManager.default.temporaryDirectory.appendingPathComponent("\(UUID().uuidString).kml")
+    fixtureFile = file
+    let kml = """
+    <kml xmlns="http://www.opengis.net/kml/2.2" xmlns:mwm="https://comaps.app"><Document><name>\(title)</name>
+    <ExtendedData><mwm:compilation id="1" type="Collection">
+    <mwm:name><mwm:lang code="default">Child</mwm:lang></mwm:name></mwm:compilation></ExtendedData>
+    <Placemark><name>Point A</name><Point><coordinates>0,0</coordinates></Point>
+    <ExtendedData><mwm:compilations>1</mwm:compilations></ExtendedData></Placemark>
+    <Placemark><name>Point B</name><Point><coordinates>1,1</coordinates></Point></Placemark>
+    <Placemark><name>Track A</name><LineString><coordinates>0,0,0 0.001,0.001,0</coordinates></LineString></Placemark>
+    <Placemark><name>Track B</name><LineString><coordinates>1,1,0 1.001,1.001,0</coordinates></LineString></Placemark>
+    </Document></kml>
+    """
+    try Data(kml.utf8).write(to: file)
+    pending = expectation(description: "Import manual fixture")
+    manager.loadBookmarkFile(file)
+    await fulfillment(of: [pending!], timeout: 30)
+    pending = nil
+    category = try XCTUnwrap(manager.sortedUserCategories().first { $0.title == title })
+  }
+
+  @MainActor
+  private func cleanupFixture() {
+    manager.remove(self)
+    if let category, manager.hasCategory(category.categoryId) { manager.deleteCategory(category.categoryId) }
+    if let fixtureFile { try? FileManager.default.removeItem(at: fixtureFile) }
+    category = nil
+    fixtureFile = nil
+  }
+
+  @MainActor
+  func testBridgePersistsCompleteSeparatePermutationsAndManualMode() async throws {
+    let category = try XCTUnwrap(category)
+    let bookmarks = Array(category.bookmarks.map(\.bookmarkId).reversed())
+    let tracks = Array(category.tracks.map(\.trackId).reversed())
+    XCTAssertTrue(manager.canManuallyOrderItems(category.categoryId))
+    XCTAssertTrue(save(bookmarks: bookmarks, tracks: tracks, in: category.categoryId))
+    XCTAssertEqual(manager.lastSortingType(category.categoryId), .manual)
+    XCTAssertEqual(category.collections.count, 1)
+    let sections = await sortedSections(category.categoryId)
+    XCTAssertEqual(sections.flatMap { $0.bookmarks ?? [] }.map(\.bookmarkId), bookmarks)
+    XCTAssertEqual(sections.flatMap { $0.tracks ?? [] }.map(\.trackId), tracks)
+  }
+
+  @MainActor
+  func testIncompleteDuplicateAndForeignIdsAreRejectedWithoutMutation() async throws {
+    let category = try XCTUnwrap(category)
+    let bookmarks = category.bookmarks.map(\.bookmarkId)
+    let tracks = category.tracks.map(\.trackId)
+    XCTAssertTrue(save(bookmarks: bookmarks, tracks: tracks, in: category.categoryId))
+    XCTAssertFalse(save(bookmarks: Array(bookmarks.dropLast()), tracks: tracks, in: category.categoryId))
+    XCTAssertFalse(save(bookmarks: [bookmarks[0], bookmarks[0]], tracks: tracks, in: category.categoryId))
+    XCTAssertFalse(save(bookmarks: [bookmarks[0], UInt64.max], tracks: tracks, in: category.categoryId))
+    let sections = await sortedSections(category.categoryId)
+    XCTAssertEqual(sections.flatMap { $0.bookmarks ?? [] }.map(\.bookmarkId), bookmarks)
+    XCTAssertEqual(sections.flatMap { $0.tracks ?? [] }.map(\.trackId), tracks)
+  }
+
+  @MainActor
+  func testChildCollectionCannotChangeParentItemRanks() async throws {
+    let root = try XCTUnwrap(category)
+    let child = try XCTUnwrap(root.collections.first)
+    XCTAssertFalse(manager.canManuallyOrderItems(child.categoryId))
+    XCTAssertFalse(save(bookmarks: child.bookmarks.map(\.bookmarkId), tracks: [], in: child.categoryId))
+    XCTAssertTrue(manager.canManuallyOrderItems(root.categoryId))
+  }
+
+  @MainActor
+  func testManualOrderAndModeSurviveKmlSaveAndReload() async throws {
+    let category = try XCTUnwrap(category)
+    let bookmarks = Array(category.bookmarks.reversed())
+    let tracks = Array(category.tracks.reversed())
+    XCTAssertTrue(save(bookmarks: bookmarks.map(\.bookmarkId), tracks: tracks.map(\.trackId), in: category.categoryId))
+    let saved = expectation(description: "Complete queued KML save")
+    manager.shareCategory(category.categoryId, fileType: .text) { status, _ in
+      XCTAssertEqual(status, .success)
+      saved.fulfill()
+    }
+    await fulfillment(of: [saved], timeout: 30)
+    manager.finishSharing()
+    let files = try FileManager.default.contentsOfDirectory(at: FileManager.default.bookmarksDirectoryUrl,
+                                                            includingPropertiesForKeys: nil)
+    let file = try XCTUnwrap(files.first { url in
+      url.pathExtension == "kml" && (try? String(contentsOf: url, encoding: .utf8).contains(category.title)) == true
+    })
+    let kml = try String(contentsOf: file, encoding: .utf8)
+    XCTAssertTrue(kml.contains("comaps:itemOrder"))
+    XCTAssertTrue(kml.contains("comaps:itemSorting"))
+    pending = expectation(description: "Reload saved KML")
+    manager.reloadCategory(atFilePath: file.path)
+    await fulfillment(of: [pending!], timeout: 30)
+    pending = nil
+    XCTAssertEqual(manager.lastSortingType(category.categoryId), .manual)
+    XCTAssertEqual(manager.category(withId: category.categoryId).collections.count, 1)
+    let sections = await sortedSections(category.categoryId)
+    XCTAssertEqual(sections.flatMap { $0.bookmarks ?? [] }.map(\.bookmarkName), bookmarks.map(\.bookmarkName))
+    XCTAssertEqual(sections.flatMap { $0.tracks ?? [] }.map(\.trackName), tracks.map(\.trackName))
+  }
+
+  @MainActor
+  private func save(bookmarks: [MWMMarkID], tracks: [MWMTrackID], in group: MWMMarkGroupID) -> Bool {
+    manager.setManualItemOrder(group, bookmarkIds: bookmarks.map { NSNumber(value: $0) },
+                               trackIds: tracks.map { NSNumber(value: $0) })
+  }
+
+  @MainActor
+  private func sortedSections(_ group: MWMMarkGroupID) async -> [BookmarksSection] {
+    let finished = expectation(description: "Read manual order")
+    var sections: [BookmarksSection] = []
+    manager.sortBookmarks(group, sortingType: .manual, location: nil) { result in
+      sections = result ?? []
+      finished.fulfill()
+    }
+    await fulfillment(of: [finished], timeout: 30)
+    return sections
+  }
+
+  func onBookmarksLoadFinished() {
+    pending?.fulfill()
+  }
+
+  func onBookmarksFileLoadError() {
+    XCTFail("Synthetic manual-order fixture could not be imported")
+    pending?.fulfill()
+  }
+}
