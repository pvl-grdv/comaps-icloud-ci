+kml::MarkGroupId CreateDeletionSafetyCategory(BookmarkManager & manager)
+{
+  auto data = LoadKmlData(MemReader(kmlString, std::strlen(kmlString)), KmlFileType::Text);
+  TEST(data, ());
+  kml::SetDefaultStr(data->m_categoryData.m_name, "Deletion safety test");
+  data->m_categoryData.m_properties["comaps:itemSorting"] = "Manual";
+  kml::CategoryData compilation;
+  compilation.m_compilationId = 42;
+  compilation.m_type = kml::CompilationType::Collection;
+  kml::SetDefaultStr(compilation.m_name, "Preserved child");
+  data->m_compilationsData.push_back(std::move(compilation));
+  TEST(!data->m_bookmarksData.empty(), ());
+  data->m_bookmarksData.front().m_compilations.push_back(42);
+  for (size_t i = 0; i < data->m_bookmarksData.size(); ++i)
+    data->m_bookmarksData[i].m_properties["comaps:itemOrder"] = std::to_string(i);
+  kml::TrackData track;
+  kml::SetDefaultStr(track.m_name, "Preserved track");
+  track.m_layers.emplace_back();
+  track.m_geometry.AddLine({{{0.0, 0.0}, 1}, {{1.0, 0.0}, 2}});
+  track.m_geometry.AddTimestamps({});
+  track.m_properties["comaps:itemOrder"] = "0";
+  data->m_tracksData.push_back(std::move(track));
+  BookmarkManager::KMLDataCollection collection;
+  collection.emplace_back("", std::move(data));
+  manager.CreateCategories(std::move(collection), true);
+  TEST_EQUAL(manager.GetBmGroupsCount(), 1, ());
+  return manager.GetUnsortedBmGroupsIdList().front();
+}
