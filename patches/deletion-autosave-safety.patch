+bool DeleteWithBlockedTrash(BookmarkManager & manager, kml::MarkGroupId groupId)
+{
+  auto const trash = std::filesystem::path(GetTrashDirectory());
+  auto backup = trash;
+  backup += ".deletion-test-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count());
+  std::filesystem::rename(trash, backup);
+  SCOPE_GUARD(restoreTrash, [&]()
+  {
+    (void)base::DeleteFileX(trash.string());
+    std::filesystem::rename(backup, trash);
+  });
+  { FileWriter blocker(trash.string()); blocker.Write("block", 5); }
+  return manager.GetEditSession().DeleteBmCategory(groupId, false);
+}
+
+void DeleteCategoryWithQueuedSave(bool permanently, bool blockTrash)
+{
+  BookmarkManager manager(BM_CALLBACKS);
+  manager.EnableTestMode(true);
+  auto const groupId = CreateDeletionSafetyCategory(manager);
+  auto const filePath = manager.GetCategoryFileName(groupId);
+  SCOPE_GUARD(fileGuard, [&]() { (void)base::DeleteFileX(filePath); });
+  auto const blocked = std::make_shared<std::promise<void>>();
+  auto const released = std::make_shared<std::promise<void>>();
+  auto const releaseFuture = released->get_future().share();
+  auto blockedFuture = blocked->get_future();
+  bool didRelease = false;
+  SCOPE_GUARD(releaseGuard, [&]() { if (!didRelease) released->set_value(); });
+  GetPlatform().RunTask(Platform::Thread::File, [blocked, releaseFuture]()
+  {
+    blocked->set_value();
+    releaseFuture.wait();
+  });
+  TEST(blockedFuture.wait_for(std::chrono::seconds(10)) == std::future_status::ready, ());
+  manager.EnableTestMode(false);
+  manager.GetEditSession().SetCategoryName(groupId, "Edited before deletion");
+  auto const hadPendingSave = manager.IsCategorySaving(groupId);
+  bool const deleted = blockTrash ? DeleteWithBlockedTrash(manager, groupId)
+                                  : manager.GetEditSession().DeleteBmCategory(groupId, permanently);
+  auto const drained = std::make_shared<std::promise<void>>();
+  auto drainedFuture = drained->get_future();
+  GetPlatform().RunTask(Platform::Thread::File, [drained]() { drained->set_value(); });
+  didRelease = true;
+  released->set_value();
+  TEST(drainedFuture.wait_for(std::chrono::seconds(10)) == std::future_status::ready, ());
+  manager.EnableTestMode(true);
+  TEST(hadPendingSave, ());
+  TEST_EQUAL(deleted, !blockTrash, ());
+  TEST_EQUAL(manager.HasBmCategory(groupId), blockTrash, ());
+  TEST_EQUAL(Platform::IsFileExistsByFullPath(filePath), blockTrash, ());
+  if (blockTrash)
+  {
+    TEST(!manager.IsCategorySaving(groupId), ());
+    auto const data = LoadKmlFile(filePath, KmlFileType::Text);
+    TEST(data, ());
+    TEST_EQUAL(kml::GetDefaultStr(data->m_categoryData.m_name), "Edited before deletion", ());
+  }
+  else if (!permanently)
+  {
+    auto const categories = manager.GetRecentlyDeletedCategories();
+    std::string trashedPath;
+    for (auto const & [path, data] : *categories)
+      if (kml::GetDefaultStr(data->m_categoryData.m_name) == "Edited before deletion")
+        trashedPath = path;
+    TEST(!trashedPath.empty(), ());
+    SCOPE_GUARD(trashGuard, [&]() { (void)base::DeleteFileX(trashedPath); });
+    auto const data = LoadKmlFile(trashedPath, KmlFileType::Text);
+    TEST(data, ());
+    TEST_EQUAL(data->m_categoryData.m_properties.at("comaps:itemSorting"), "Manual", ());
+    TEST_EQUAL(data->m_tracksData.size(), 1, ());
+    TEST_EQUAL(data->m_tracksData.front().m_properties.at("comaps:itemOrder"), "0", ());
+    TEST_EQUAL(data->m_compilationsData.size(), 1, ());
+  }
+}
+}
