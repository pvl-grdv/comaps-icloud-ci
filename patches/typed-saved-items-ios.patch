+- (void)searchSavedItemsInGroup:(MWMMarkGroupID)groupId
+                          text:(NSString *)text
+                    completion:(SearchSavedItemsCompletionBlock)completion
+{
+  auto const searchId = ++self.lastSearchId;
+  __weak auto weakSelf = self;
+  search::SavedItemsSearchParams params;
+  params.m_query = text.UTF8String;
+  params.m_groupId = groupId;
+  auto const groups = groupId == kml::kInvalidMarkGroupId
+      ? self.bm.GetSortedBmGroupIdList() : std::vector<kml::MarkGroupId>{groupId};
+  for (auto const categoryId : groups) {
+    if (!self.bm.HasBmCategory(categoryId))
+      continue;
+    for (auto const bookmarkId : self.bm.GetUserMarkIds(categoryId)) {
+      auto const * bookmark = self.bm.GetBookmark(bookmarkId);
+      if (bookmark)
+        params.m_documents.push_back({{search::bookmarks::ItemKind::Bookmark, bookmarkId}, categoryId,
+                                      search::bookmarks::Data(bookmark->GetData())});
+    }
+    for (auto const trackId : self.bm.GetTrackIds(categoryId)) {
+      auto const * track = self.bm.GetTrack(trackId);
+      if (track)
+        params.m_documents.push_back({{search::bookmarks::ItemKind::Track, trackId}, categoryId,
+                                      search::bookmarks::Data(track->GetData())});
+    }
+  }
+  params.m_onResults = [weakSelf, searchId, groupId, completion](search::bookmarks::ItemResults results,
+                                                             search::SavedItemsSearchParams::Status status) {
+    __strong auto self = weakSelf;
+    if (!self || searchId != self.lastSearchId)
+      return;
+    if (status == search::SavedItemsSearchParams::Status::Cancelled) {
+      completion(@[]);
+      return;
+    }
+    NSMutableArray<MWMSavedItemSearchResult *> * items = [NSMutableArray array];
+    for (auto const & result : results) {
+      auto const itemId = result.m_item.m_id;
+      kml::MarkGroupId categoryId;
+      MWMSavedItemKind kind;
+      if (result.m_item.m_kind == search::bookmarks::ItemKind::Bookmark) {
+        auto const * bookmark = self.bm.GetBookmark(itemId);
+        if (!bookmark)
+          continue;
+        categoryId = bookmark->GetGroupId();
+        kind = MWMSavedItemKindBookmark;
+      } else {
+        auto const * track = self.bm.GetTrack(itemId);
+        if (!track)
+          continue;
+        categoryId = track->GetGroupId();
+        kind = MWMSavedItemKindTrack;
+      }
+      if (groupId != kml::kInvalidMarkGroupId) {
+        if (!self.bm.HasBmCategory(groupId))
+          continue;
+        if (kind == MWMSavedItemKindBookmark && !self.bm.GetUserMarkIds(groupId).count(itemId))
+          continue;
+        if (kind == MWMSavedItemKindTrack && !self.bm.GetTrackIds(groupId).count(itemId))
+          continue;
+        categoryId = groupId;
+      }
+      if (!self.bm.HasBmCategory(categoryId))
+        continue;
+      [items addObject:[[MWMSavedItemSearchResult alloc] initWithKind:kind itemId:itemId categoryId:categoryId]];
+    }
+    completion(items);
+  };
+  if (!GetFramework().GetSearchAPI().SearchSavedItems(std::move(params)))
+    completion(@[]);
+}
+
+- (void)searchAllSavedItems:(NSString *)text completion:(SearchSavedItemsCompletionBlock)completion
+{
+  [self searchSavedItemsInGroup:kml::kInvalidMarkGroupId text:text completion:completion];
+}
+
+- (void)cancelSavedItemsSearch
+{
+  ++self.lastSearchId;
+  GetFramework().GetSearchAPI().CancelSearch(search::Mode::Bookmarks);
+}
+
+- (BOOL)hasSavedItemKind:(MWMSavedItemKind)kind itemId:(uint64_t)itemId inGroup:(MWMMarkGroupID)groupId
+{
+  if (!self.bm.HasBmCategory(groupId))
+    return NO;
+  switch (kind) {
+    case MWMSavedItemKindBookmark:
+      return self.bm.HasBookmark(itemId) && self.bm.GetUserMarkIds(groupId).count(itemId) != 0;
+    case MWMSavedItemKindTrack:
+      return self.bm.HasTrack(itemId) && self.bm.GetTrackIds(groupId).count(itemId) != 0;
+  }
+  return NO;
+}
