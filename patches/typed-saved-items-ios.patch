diff --git a/iphone/Maps/Bookmarks/Categories/BMCViewModel/BMCSavedItemsSearchService.swift b/iphone/Maps/Bookmarks/Categories/BMCViewModel/BMCSavedItemsSearchService.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Bookmarks/Categories/BMCViewModel/BMCSavedItemsSearchService.swift
@@ -0,0 +1,73 @@
+import Foundation
+
+final class BMCSavedItemsSearchService: BMCSearchService {
+  private let manager = BookmarksManager.shared()
+  private let groupId: MWMMarkGroupID?
+
+  init(groupId: MWMMarkGroupID? = nil) {
+    self.groupId = groupId
+  }
+
+  func prepare() {}
+
+  func release() {
+    manager.cancelSavedItemsSearch()
+  }
+
+  func search(_ text: String, completion: @escaping ([BMCSearchResult]) -> Void) {
+    let onResults: ([SavedItemSearchResult]) -> Void = { [weak self] items in
+      guard let self else { return }
+      completion(items.compactMap { item in
+        guard manager.hasCategory(item.categoryId) else { return nil }
+        let category = manager.category(withId: item.categoryId)
+        switch item.kind {
+        case .bookmark:
+          guard manager.hasBookmark(item.itemId) else { return nil }
+          let bookmark = manager.bookmark(withId: item.itemId)
+          return BMCSearchResult(item: .bookmark(item.itemId), categoryId: category.categoryId,
+                                 categoryName: category.title, name: bookmark.bookmarkName,
+                                 subtitle: bookmark.bookmarkType)
+        case .track:
+          guard manager.hasTrack(item.itemId) else { return nil }
+          let track = manager.track(withId: item.itemId)
+          let distance = DistanceFormatter.distanceString(fromMeters: Double(track.trackLengthMeters))
+          return BMCSearchResult(item: .track(item.itemId), categoryId: category.categoryId,
+                                 categoryName: category.title, name: track.trackName,
+                                 subtitle: "\(L("length")) \(distance)")
+        @unknown default:
+          return nil
+        }
+      })
+    }
+    if let groupId {
+      manager.searchSavedItems(inGroup: groupId, text: text, completion: onResults)
+    } else {
+      manager.searchAllSavedItems(text, completion: onResults)
+    }
+  }
+
+  func resolveSelection(_ result: BMCSearchResult) -> BMCSearchResult? {
+    let category: BookmarkGroup
+    switch result.item {
+    case .bookmark(let id):
+      guard manager.hasBookmark(id) else { return nil }
+      if let groupId {
+        guard manager.hasSavedItem(.bookmark, itemId: id, inGroup: groupId) else { return nil }
+        category = manager.category(withId: groupId)
+      } else {
+        category = manager.category(forBookmarkId: id)
+      }
+    case .track(let id):
+      guard manager.hasTrack(id) else { return nil }
+      if let groupId {
+        guard manager.hasSavedItem(.track, itemId: id, inGroup: groupId) else { return nil }
+        category = manager.category(withId: groupId)
+      } else {
+        category = manager.category(forTrackId: id)
+      }
+    }
+    guard manager.hasCategory(category.categoryId) else { return nil }
+    return BMCSearchResult(item: result.item, categoryId: category.categoryId,
+                           categoryName: category.title, name: result.name, subtitle: result.subtitle)
+  }
+}
