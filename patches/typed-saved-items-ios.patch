diff --git a/iphone/Maps/Tests/Bookmarks/Categories/SavedItemsSearchTests.swift b/iphone/Maps/Tests/Bookmarks/Categories/SavedItemsSearchTests.swift
new file mode 100644
--- /dev/null
+++ b/iphone/Maps/Tests/Bookmarks/Categories/SavedItemsSearchTests.swift
@@ -0,0 +1,191 @@
+import XCTest
+@testable import CoMaps__Debug_
+
+final class SavedItemsSearchTests: XCTestCase, BookmarksObserver {
+  private var manager: BookmarksManager { BookmarksManager.shared() }
+  private var loading: XCTestExpectation?
+  private var importing: XCTestExpectation?
+  private var categories: [BookmarkGroup] = []
+  private var files: [URL] = []
+
+  override func setUp() async throws {
+    try await super.setUp()
+    try await prepareFixtures()
+  }
+
+  @MainActor
+  private func prepareFixtures() async throws {
+    manager.add(self)
+    if !manager.areBookmarksLoaded() {
+      loading = expectation(description: "Bookmark loading")
+      manager.loadBookmarks()
+      await fulfillment(of: [loading!], timeout: 30)
+      loading = nil
+    }
+    try await importCategory()
+    try await importCategory()
+  }
+
+  override func tearDown() async throws {
+    await cleanupFixtures()
+    try await super.tearDown()
+  }
+
+  @MainActor
+  private func cleanupFixtures() {
+    manager.cancelSavedItemsSearch()
+    manager.releaseSearch()
+    manager.remove(self)
+    for category in categories where manager.hasCategory(category.categoryId) {
+      manager.deleteCategory(category.categoryId)
+    }
+    for file in files { try? FileManager.default.removeItem(at: file) }
+    categories = []
+    files = []
+  }
+
+  @MainActor
+  func testTypedResultPreservesKindWithEqualNumericIds() async {
+    let bookmark = SavedItemSearchResult(kind: .bookmark, itemId: 42, categoryId: categories[0].categoryId)
+    let track = SavedItemSearchResult(kind: .track, itemId: 42, categoryId: categories[0].categoryId)
+    XCTAssertEqual(bookmark.itemId, track.itemId)
+    XCTAssertNotEqual(bookmark.kind, track.kind)
+  }
+
+  @MainActor
+  func testCurrentFolderSearchReturnsBothKindsFromOnlyThatFolder() async {
+    let group = categories[0]
+    let items = await search("needle", in: group.categoryId)
+    XCTAssertEqual(items.count, 2)
+    XCTAssertTrue(items.contains { $0.kind == .bookmark })
+    XCTAssertTrue(items.contains { $0.kind == .track })
+    XCTAssertTrue(items.allSatisfy { $0.categoryId == group.categoryId })
+  }
+
+  @MainActor
+  func testGlobalSearchIncludesBothFoldersAndBothKinds() async {
+    let ids = Set(categories.map(\.categoryId))
+    let items = await search("needle").filter { ids.contains($0.categoryId) }
+    XCTAssertEqual(items.count, 4)
+    XCTAssertEqual(Set(items.map(\.categoryId)), ids)
+    XCTAssertEqual(items.filter { $0.kind == .track }.count, 2)
+  }
+
+  @MainActor
+  func testChildCollectionSearchUsesMembershipInsteadOfPrimaryParent() async throws {
+    let root = categories[0]
+    let child = try XCTUnwrap(root.collections.first)
+    let bookmark = try XCTUnwrap(child.bookmarks.first)
+    XCTAssertEqual(manager.category(forBookmarkId: bookmark.bookmarkId).categoryId, root.categoryId)
+    XCTAssertNotEqual(root.categoryId, child.categoryId)
+    let items = await search("needle", in: child.categoryId)
+    XCTAssertEqual(items.map(\.itemId), [bookmark.bookmarkId])
+    XCTAssertEqual(items.map(\.categoryId), [child.categoryId])
+    XCTAssertEqual(items.first?.kind, .bookmark)
+    XCTAssertTrue(manager.hasSavedItem(.bookmark, itemId: bookmark.bookmarkId, inGroup: child.categoryId))
+  }
+
+  @MainActor
+  func testRenamedTrackIsReplacedInTheNextSearchSnapshot() async throws {
+    let category = categories[0]
+    let track = try XCTUnwrap(category.tracks.first)
+    manager.updateTrack(track.trackId, setGroupId: category.categoryId, color: track.trackColor, title: "Different route")
+    let oldNameResults = await search("needle", in: category.categoryId)
+    let newNameResults = await search("different", in: category.categoryId)
+    XCTAssertFalse(oldNameResults.contains { $0.kind == .track })
+    XCTAssertEqual(newNameResults.filter { $0.kind == .track }.map(\.itemId), [track.trackId])
+  }
+
+  @MainActor
+  func testMovedTrackLeavesOldScopeAndAppearsInNewScope() async throws {
+    let source = categories[0]
+    let target = categories[1]
+    let track = try XCTUnwrap(source.tracks.first)
+    manager.moveTrack(track.trackId, toGroupId: target.categoryId)
+    XCTAssertFalse(manager.hasSavedItem(.track, itemId: track.trackId, inGroup: source.categoryId))
+    XCTAssertTrue(manager.hasSavedItem(.track, itemId: track.trackId, inGroup: target.categoryId))
+    let sourceResults = await search("needle", in: source.categoryId)
+    let targetResults = await search("needle", in: target.categoryId)
+    XCTAssertFalse(sourceResults.contains { $0.kind == .track && $0.itemId == track.trackId })
+    XCTAssertTrue(targetResults.contains { $0.kind == .track && $0.itemId == track.trackId })
+  }
+
+  @MainActor
+  func testDeletedTrackIsNotSearchableOrSelectable() async throws {
+    let category = categories[0]
+    let track = try XCTUnwrap(category.tracks.first)
+    manager.deleteTrack(track.trackId)
+    XCTAssertFalse(manager.hasSavedItem(.track, itemId: track.trackId, inGroup: category.categoryId))
+    let results = await search("needle", in: category.categoryId)
+    XCTAssertFalse(results.contains { $0.kind == .track })
+  }
+
+  @MainActor
+  func testLegacyBookmarkSearchStillReturnsOnlyBookmarks() async {
+    let category = categories[0]
+    manager.prepare(forSearch: category.categoryId)
+    let finished = expectation(description: "Legacy bookmark search")
+    var returned: [Bookmark] = []
+    var didFinish = false
+    manager.searchBookmarksGroup(category.categoryId, text: "needle") { bookmarks in
+      returned = bookmarks
+      if !didFinish && bookmarks.count == category.bookmarks.count {
+        didFinish = true
+        finished.fulfill()
+      }
+    }
+    await fulfillment(of: [finished], timeout: 30)
+    XCTAssertEqual(returned.map(\.bookmarkId), category.bookmarks.map(\.bookmarkId))
+  }
+
+  @MainActor
+  private func search(_ text: String, in groupId: MWMMarkGroupID? = nil) async -> [SavedItemSearchResult] {
+    let finished = expectation(description: "Saved item search")
+    var items: [SavedItemSearchResult] = []
+    let completion: ([SavedItemSearchResult]) -> Void = { results in
+      items = results
+      finished.fulfill()
+    }
+    if let groupId {
+      manager.searchSavedItems(inGroup: groupId, text: text, completion: completion)
+    } else {
+      manager.searchAllSavedItems(text, completion: completion)
+    }
+    await fulfillment(of: [finished], timeout: 30)
+    return items
+  }
+
+  @MainActor
+  private func importCategory() async throws {
+    let title = "Search fixture \(UUID().uuidString)"
+    let file = FileManager.default.temporaryDirectory.appendingPathComponent("\(UUID().uuidString).kml")
+    let data = """
+    <?xml version="1.0" encoding="UTF-8"?>
+    <kml xmlns="http://www.opengis.net/kml/2.2" xmlns:mwm="https://comaps.app"><Document><name>\(title)</name>
+    <ExtendedData><mwm:compilation id="1" type="Collection">
+    <mwm:name><mwm:lang code="default">Child collection</mwm:lang></mwm:name>
+    </mwm:compilation></ExtendedData>
+    <Placemark><name>Needle point</name><Point><coordinates>0,0</coordinates></Point>
+    <ExtendedData><mwm:compilations>1</mwm:compilations></ExtendedData></Placemark>
+    <Placemark><name>Needle route</name><LineString><coordinates>0,0,0 0.001,0.001,0</coordinates></LineString></Placemark>
+    </Document></kml>
+    """
+    try Data(data.utf8).write(to: file)
+    files.append(file)
+    importing = expectation(description: "Import search fixture")
+    manager.loadBookmarkFile(file)
+    await fulfillment(of: [importing!], timeout: 30)
+    importing = nil
+    categories.append(try XCTUnwrap(manager.sortedUserCategories().first { $0.title == title }))
+  }
+
+  func onBookmarksLoadFinished() {
+    loading?.fulfill()
+    importing?.fulfill()
+  }
+
+  func onBookmarksFileLoadError() {
+    XCTFail("Failed to import synthetic search fixture")
+    importing?.fulfill()
+  }
+}
